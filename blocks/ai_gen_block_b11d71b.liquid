{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-feature-icons-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top_desktop }}px 0 {{ block.settings.padding_bottom_desktop }}px;
    display: flex;
  }

  .ai-feature-icons-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
  }

  .ai-feature-icons-heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.heading_bottom_spacing }}px;
    font-size: {{ block.settings.heading_size_desktop }}px;
    font-weight: {{ block.settings.heading_weight }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    line-height: 1.2;
  }

  .ai-feature-icons-heading-{{ ai_gen_id }} strong {
    color: {{ block.settings.heading_color_b }};
  }

  .ai-feature-icons-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.items_gap }}px;
  }

  .ai-feature-icons-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: {{ block.settings.item_padding }}px;
  }

  .ai-feature-icons-icon-wrapper-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.icon_text_spacing }}px;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-icons-icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: {{ block.settings.icon_border_radius }}px;
  }

  .ai-feature-icons-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-icons-icon-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-feature-icons-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size_desktop }}px;
    line-height: {{ block.settings.text_line_height }};
    text-align: {{ block.settings.text_alignment }};
    letter-spacing:0;
    max-width: {{ block.settings.text_max_width }}px;
    margin: 0;
  }

  .ai-feature-icons-slider-{{ ai_gen_id }} {
    display: none;
  }

  .ai-feature-icons-pagination-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .ai-feature-icons-pagination-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: black;
    opacity: 0.3;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-feature-icons-pagination-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }
  .ai-feature-icons-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    line-height: 100%;
    margin-bottom: 12px;
  }
  @media screen and (max-width: 749px) {
    .ai-feature-icons-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 0 {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-feature-icons-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-feature-icons-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
    }

    {% if block.settings.enable_mobile_slider %}
      .ai-feature-icons-grid-{{ ai_gen_id }} {
        display: none;
      }

      .ai-feature-icons-slider-{{ ai_gen_id }} {
        display: block;
        overflow: hidden;
        position: relative;
      }

      .ai-feature-icons-slider-track-{{ ai_gen_id }} {
        display: flex;
        transition: transform 0.5s ease;
      }

      .ai-feature-icons-slide-{{ ai_gen_id }} {
        width: 100%;
        flex-shrink: 0;
      }
    {% else %}
      .ai-feature-icons-grid-{{ ai_gen_id }} {
        grid-template-columns: 1fr;
      }

      .ai-feature-icons-pagination-{{ ai_gen_id }} {
        display: none;
      }
    {% endif %}
  }
{% endstyle %}

