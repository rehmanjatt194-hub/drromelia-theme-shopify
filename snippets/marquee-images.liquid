<style>
.marquee-{{ block.id }} {
    background: {{ block.settings.bg_color }};
    display: flex;
    align-items: center;
    gap: 16px;
    overflow: hidden;
    border-radius: 8px;
    padding: 10px 18px!important;
}

.marquee-inner-{{ block.id }} {
  display: flex;
  align-items: center;
  white-space: nowrap;
  animation: marquee {{ block.settings.speed }}s linear infinite;
  animation-direction: {% if block.settings.direction == 'right' %}reverse{% else %}normal{% endif %};
}

.marquee-item-{{ block.id }} {
  display: flex;
  align-items: center;
  gap: 40px;
  margin-right: 40px;
}

.marquee-title-{{ block.id }} {
  font-size: {{ block.settings.title_size }}px;
  color: {{ block.settings.title_color }};
  font-weight: 400;
  white-space: nowrap;
}
.marquee-anime-wrapper {
    overflow: hidden;
}
.marquee-item-{{ block.id }} img {
  height: {{ block.settings.logo_height }}px;
  width: auto;
  display: block;
}
.marquee-anime-wrapper:before {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 48px;
    pointer-events: none;
    z-index: 2;
    content: '';
    left: 0;
    background: linear-gradient(to right, {{ block.settings.bg_color }}, transparent);
}

.marquee-anime-wrapper {
    position: relative;
}

.marquee-anime-wrapper:after {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 48px;
    pointer-events: none;
    z-index: 2;
    right: 0;
    background: linear-gradient(to left, {{ block.settings.bg_color }}, transparent);
    content: '';
}
@keyframes marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-100%); }
}
@media (max-width: 750px){
 .marquee-title-{{ block.id }} {
  font-size: 12px;
 }
}
</style>

<div class="marquee-{{ block.id }}">
  {% if block.settings.title != blank %}
    <div class="marquee-title-{{ block.id }}">{{ block.settings.title }}</div>
  {% endif %}
  <div class="marquee-anime-wrapper">
    <div class="marquee-inner-{{ block.id }}">
        {% for i in (1..100) %}
        <div class="marquee-item-{{ block.id }}">
            {% for n in (1..10) %}
                {% assign img_key = 'img' | append: n %}
                {% assign img = block.settings[img_key] %}
                {% if img != blank %}
                    {% render 'lx-liquid-image' image: img %}
                {% endif %}
            {% endfor %}
        </div>
        {% endfor %}
    </div>
  </div>
</div>