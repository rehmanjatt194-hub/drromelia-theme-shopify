{{ 'lx-before-and-after-slider.css' | asset_url | stylesheet_tag }}


<div class="after-and-before-slider-container" style="---btn_bg:{{ section.settings.btns__bg }};---btn_color:{{ section.settings.btns__color }};">
  <div class="before-image">
    {% render 'lx-liquid-image' image: section.settings.before_image %}
    {% if section.settings.before_text != blank %}
        <div class="before-text">{{ section.settings.before_text }}</div>
    {% endif %}
  </div>
  <div class="after-image">
    {% render 'lx-liquid-image' image: section.settings.after_image %}
    {% if section.settings.after_text != blank %}
        <div class="after-text">{{ section.settings.after_text }}</div>
    {% endif %}
  </div>
  <div class="slider-handle" id="sliderHandle"></div>
  <div class="slider-line">
    <div class="pulse-container">
        <svg width="45" height="45" viewBox="0 0 45 45" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="22.5" cy="22.5" r="22.5" fill="#D9D9D9"/>
        <g clip-path="url(#clip0_2068_4)">
