        </g>
        <g clip-path="url(#clip1_2068_4)">
        <path d="M17.2633 15.4997L17.2633 30.4997C17.2633 30.646 17.2382 30.7897 17.1907 30.9164C17.1431 31.043 17.0748 31.1482 16.9924 31.2214C16.9101 31.2945 16.8167 31.333 16.7216 31.333C16.6265 31.333 16.5331 31.2945 16.4508 31.2214L8.00725 23.7214C7.92994 23.6423 7.86653 23.535 7.82267 23.4091C7.77881 23.2832 7.75586 23.1425 7.75586 22.9997C7.75586 22.8568 7.77881 22.7162 7.82267 22.5903C7.86653 22.4644 7.92994 22.3571 8.00725 22.278L16.4508 14.778C16.5331 14.7049 16.6265 14.6664 16.7216 14.6664C16.8167 14.6664 16.9101 14.7049 16.9924 14.778C17.0748 14.8512 17.1431 14.9564 17.1907 15.083C17.2382 15.2097 17.2633 15.3534 17.2633 15.4997Z" fill="#172243"/>
