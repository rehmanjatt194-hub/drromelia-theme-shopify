<div class="kr--video-modal__carousel">
  <div class="kr--video-modal__block">
    <div class="swiper kr--video-modal__carousel_block">
      <div class="swiper-wrapper">
        {% if block.settings.use_metaobject_data and product.metafields.custom.product_slider_images.value != blank %}

          {% for meta in product.metafields.custom.product_slider_images.value %}
            {% if meta.popup_video != blank %}
              <div class="kr--video_modal_item swiper-slide">
                <div class="kr--vm_card_item" video__index="{{ forloop.index }}">
                  <video 
                    muted 
                    playsinline 
                    autoplay 
                    preload="none" 
                    loop 
                    src="{{ meta.popup_video | metafield_text }}">
                  </video>

                  <div class="kr--video-carousel__mute-control active">
                    <!-- mute / unmute icons -->
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}

        {% else %}

          {% for i in (1..6) %}
            {% assign video_key = 'video_' | append: i %}

            {% if block.settings[video_key] != blank %}
              <div class="kr--video_modal_item swiper-slide">
                <div class="kr--vm_card_item" video__index="{{ forloop.index }}">
                  {{ block.settings[video_key] | video_tag:
                    autoplay: true,
                    muted: true,
                    loop: true,
                    playsinline: true,
                    preload: 'none'
                  }}

                  <div class="kr--video-carousel__mute-control active">
                    <!-- mute / unmute icons -->
                  </div>
                </div>
              </div>
            {% endif %}

          {% endfor %}

        {% endif %}
      </div>
      <div class="kr--all-progress-bars"></div>
    </div>
  </div>

  <button class="kr_modal_close-button">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path fill-rule="evenodd" clip-rule="evenodd"
        d="M12.0002 10.586L4.70718 3.29297L3.29297 4.70718L10.586 12.0002L3.29297 19.2933L4.70718 20.7075L12.0002 13.4145L19.2933 20.7075L20.7075 19.2933L13.4145 12.0002L20.7075 4.70723L19.2933 3.29302L12.0002 10.586Z"
        fill="white"></path>
    </svg>
  </button>

  <button class="kr_modal_prev--button">
    <svg viewBox="0 0 24 24">
      <path d="m8.5 12.8 5.7 5.6c.4.4 1 .4 1.4 0 .4-.4.4-1 0-1.4l-4.9-5 4.9-5c.4-.4.4-1 0-1.4-.2-.2-.4-.3-.7-.3-.3 0-.5.1-.7.3l-5.7 5.6c-.4.5-.4 1.1 0 1.6 0-.1 0-.1 0 0z"></path>
    </svg>
  </button>

  <button class="kr_modal_next--button">
    <svg viewBox="0 0 24 24">
      <path d="M15.54,11.29,9.88,5.64a1,1,0,0,0-1.42,0,1,1,0,0,0,0,1.41l4.95,5L8.46,17a1,1,0,0,0,0,1.41,1,1,0,0,0,.71.3,1,1,0,0,0,.71-.3l5.66-5.65A1,1,0,0,0,15.54,11.29Z"></path>
    </svg>
  </button>
</div>