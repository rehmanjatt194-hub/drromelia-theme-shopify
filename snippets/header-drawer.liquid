{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

<style>
  /* ── Drawer Shell ── */
  .drawer__custom-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 20px;
    border-bottom: 1px solid #eaeaea;
    position: relative;
  }
  .drawer__custom-title {
    font-size: 13px;
    font-weight: 700;
    margin: 0;
    color: #888;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .drawer__custom-close {
    background: transparent;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease;
  }
  .drawer__custom-close:hover {
    transform: scale(1.1);
  }
  .drawer__custom-close svg {
    width: 24px;
    height: 24px;
  }
  .drawer__custom-close svg path {
    stroke: #111;
  }

  /* ── Nav Container ── */
  .dr-drawer-nav {
    flex: 1;
    overflow-y: auto;
    padding: 8px 0 0;
  }

  /* ── Section Label ── */
  .dr-drawer-section-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #aaa;
    padding: 18px 22px 8px;
  }

  /* ── Primary Links (Bold) ── */
  .dr-drawer-primary {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .dr-drawer-primary li {
    border-bottom: 1px solid #f0f0f0;
  }
  .dr-drawer-primary a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 22px;
    font-size: 16px;
    font-weight: 700;
    color: #111;
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .dr-drawer-primary a:hover {
    color: #6f2c91;
    background: #f8f3fc;
  }
  .dr-drawer-primary a .dr-link-arrow {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    font-size: 18px;
    font-weight: 400;
    color: #f46f9a;
  }
  .dr-drawer-primary a:hover .dr-link-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ── Deals link — stands out with brand PINK ── */
  .dr-drawer-primary a.dr-deals-link {
    color: #f46f9a;
  }
  .dr-drawer-primary a.dr-deals-link .dr-deals-badge {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(135deg, #fce8f2, #f9cde1);
    border: 1px solid rgba(244,111,154,0.3);
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #f46f9a;
    padding: 3px 10px;
    text-transform: uppercase;
  }

  /* ── Section Divider ── */
  .dr-drawer-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0,0,0,0.08), transparent);
    margin: 8px 22px;
  }

  /* ── Secondary Links (Regular weight) ── */
  .dr-drawer-secondary {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .dr-drawer-secondary li {
    border-bottom: 1px solid #f5f5f5;
  }
  .dr-drawer-secondary a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    font-size: 14px;
    font-weight: 400;
    color: #444;
    text-decoration: none;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .dr-drawer-secondary a:hover {
    color: #111;
    background: #fafafa;
  }
  .dr-drawer-secondary a svg {
    flex-shrink: 0;
    color: #999;
    transition: color 0.2s ease;
  }
  .dr-drawer-secondary a:hover svg {
    color: #f46f9a;
  }

  /* ── Footer ── */
  .drawer__custom-footer {
    padding: 22px 22px 16px;
    background: #f9f9f9;
    border-top: 1px solid #eaeaea;
    margin-top: auto;
  }
  .drawer__custom-footer-help-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #aaa;
    margin: 0 0 10px;
  }
  .drawer__custom-footer-phone {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: #111;
    text-decoration: none;
    margin-bottom: 14px;
    transition: color 0.2s ease;
  }
  .drawer__custom-footer-phone:hover {
    color: #25D366;
  }
  .drawer__custom-footer-phone .dr-wa-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: #25D366;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .drawer__custom-footer-phone .dr-wa-icon svg {
    width: 16px;
    height: 16px;
    fill: #fff;
  }
  .dr-drawer-account-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid #eaeaea;
    margin-top: 4px;
  }
  .dr-drawer-account-link {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    letter-spacing: 0.01em;
  }
  .dr-drawer-login-btn {
    background: #111;
    color: #fff;
    border: 1px solid #111;
  }
  .dr-drawer-login-btn:hover {
    background: linear-gradient(135deg, #6f2c91, #a044c8);
    border-color: #6f2c91;
  }
  .dr-drawer-register-btn {
    background: transparent;
    color: #111;
    border: 1px solid #ddd;
  }
  .dr-drawer-register-btn:hover {
    border-color: #f46f9a;
    color: #f46f9a;
  }

  /* Hide the default Dawn close icon */
  .js .icon-close,
  details[open] > summary .icon-close {
    display: none !important;
  }

  /* Make drawer cover full screen height from top */
  .menu-drawer,
  .js .menu-drawer {
    top: 0 !important;
    height: 100vh !important;
    display: flex;
    flex-direction: column;
  }
  .menu-drawer__inner-container {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .menu-drawer__navigation-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }
  .menu-drawer__navigation {
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: hidden;
  }

  /* Adjust drawer width on mobile to leave room for closing by clicking outside */
  @media screen and (max-width: 749px) {
    .menu-drawer {
      width: calc(100% - 53px) !important;
    }
  }
</style>


<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">

      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          {% comment %} <div class="menu_drawer-mega_images">
            {% for block in section.blocks %}
              <div class="menu_drawer-mega_item">
                {% if block.settings.image_1 %}
                  <div class="menu_drawer-mega_item-image">
                      {% render 'lx-liquid-image' image: block.settings.image_1 %}
                  </div>
                {% endif %}
                {% if block.settings.title_1 %}
                  <div class="menu_drawer-mega_item-info">
                     <a href="{{ block.settings.link_1 }}">
                        {{ block.settings.title_1 }}
                     </a>
                     {% if block.settings.text_1 != '' %}
                      <div class="mega_item-info-text">
                          {{ block.settings.text_1 }}
                          <svg class="svg-inline--fa fa-arrow-right fa-sm ml-0" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="arrow-right" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" data-fa-i2svg=""><path fill="currentColor" d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"></path></svg>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
              <div class="menu_drawer-mega_item">
                {% if block.settings.image_2 %}
                  <div class="menu_drawer-mega_item-image">
                      {% render 'lx-liquid-image' image: block.settings.image_2 %}
                  </div>
                {% endif %}
                {% if block.settings.text_2 %}
                  <div class="menu_drawer-mega_item-info">
                     <a href="{{ block.settings.link_2 }}">
                        {{ block.settings.title_2 }}
                     </a>
                     {% if block.settings.text_2 != '' %}
                      <div class="mega_item-info-text">
                          {{ block.settings.text_2 }}
                          <svg class="svg-inline--fa fa-arrow-right fa-sm ml-0" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="arrow-right" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" data-fa-i2svg=""><path fill="currentColor" d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"></path></svg>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div> {% endcomment %}
          <div class="drawer__custom-header">
            <h2 class="drawer__custom-title">MENU</h2>
            <div class="drawer__custom-close" onclick="document.querySelector('#Details-menu-drawer-container > summary').click()">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 6L18 18M18 6L6 18" stroke="#111" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
          </div>
          
          <nav class="menu-drawer__navigation" aria-label="Mobile navigation">

            {%- comment -%} ── PRIMARY LINKS ── {%- endcomment -%}
            <div class="dr-drawer-nav">
              <p class="dr-drawer-section-label">Navigation</p>
              <ul class="dr-drawer-primary" role="list">
                <li>
                  <a href="/" id="DrawerLink-home">
                    Home
                    <span class="dr-link-arrow" aria-hidden="true">&rsaquo;</span>
                  </a>
                </li>
                <li>
                  <a href="/collections/all" id="DrawerLink-shop-all">
                    Shop All
                    <span class="dr-link-arrow" aria-hidden="true">&rsaquo;</span>
                  </a>
                </li>
                <li>
                  <a href="/collections/best-sellers" id="DrawerLink-best-sellers">
                    Best Sellers
                    <span class="dr-link-arrow" aria-hidden="true">&rsaquo;</span>
                  </a>
                </li>
                <li>
                  <a href="/collections/deals" class="dr-deals-link" id="DrawerLink-deals">
                    <span>Deals &amp; Offers</span>
                    <span class="dr-deals-badge">Hot</span>
                  </a>
                </li>
              </ul>

              {%- comment -%} ── DIVIDER ── {%- endcomment -%}
              <div class="dr-drawer-divider" role="separator" aria-hidden="true"></div>

              {%- comment -%} ── SECONDARY LINKS ── {%- endcomment -%}
              <p class="dr-drawer-section-label">Explore</p>
              <ul class="dr-drawer-secondary" role="list">
                <li>
                  <a href="/pages/about" id="DrawerLink-about">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                    About Dr. Romelia
                  </a>
                </li>
                <li>
                  <a href="/pages/track-order" id="DrawerLink-track">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    Track Your Order
                  </a>
                </li>
                <li>
                  <a href="/pages/faqs" id="DrawerLink-faqs">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    FAQs
                  </a>
                </li>
                <li>
                  <a href="/pages/contact" id="DrawerLink-contact">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    Contact Us
                  </a>
                </li>
              </ul>
            </div>

            {%- comment -%} ── FOOTER ── {%- endcomment -%}
            <div class="drawer__custom-footer">

              <div class="dr-drawer-account-row">
                {%- if customer -%}
                  <a href="{{ routes.account_url }}" class="dr-drawer-account-link dr-drawer-login-btn" id="DrawerLink-account">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                    My Account
                  </a>
                {%- else -%}
                  <a href="{{ routes.account_login_url }}" class="dr-drawer-account-link dr-drawer-login-btn" id="DrawerLink-login">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                    Log In
                  </a>
                  <a href="{{ routes.account_register_url }}" class="dr-drawer-account-link dr-drawer-register-btn" id="DrawerLink-register">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                    Register
                  </a>
                {%- endif -%}
              </div>
            </div>

          </nav>

          <div class="menu-drawer__utility-links hide">
            {%- if shop.customer_accounts_enabled -%}
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="menu-drawer__account link focus-inset h5 medium-hide large-up-hide"
                rel="nofollow"
              >
                {%- if section.settings.enable_customer_avatar -%}
                  <account-icon>
                    {%- if customer and customer.has_avatar? -%}
                      {{ customer | avatar }}
                    {%- else -%}
                      <span class="svg-wrapper">
                        {{- 'icon-account.svg' | inline_asset_content -}}
                      </span>
                    {%- endif -%}
                  </account-icon>
                {%- else -%}
                  <span class="svg-wrapper">
                    {{- 'icon-account.svg' | inline_asset_content -}}
                  </span>
                {%- endif -%}
                {%- liquid
                  if customer
                    echo 'customer.account_fallback' | t
                  else
                    echo 'customer.log_in' | t
                  endif
                -%}
              </a>
            {%- endif -%}
            {%- if localization.available_countries or localization.available_languages -%}
              <div class="menu-drawer__localization header-localization">
                {%- if localization.available_countries and localization.available_countries.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderCountryMobileLabel">
                          {{ 'localization.country_label' | t }}
                        </h2>
                        {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {% endif %}

                {%- if localization.available_languages and localization.available_languages.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">
                          {{ 'localization.language_label' | t }}
                        </h2>
                        {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
              </div>
            {%- endif -%}
            <ul class="list list-social list-unstyled" role="list">
              {%- if settings.social_twitter_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_twitter_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-twitter.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_facebook_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_facebook_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-facebook.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_pinterest_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_pinterest_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-pinterest.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_instagram_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_instagram_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-instagram.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_tiktok_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-tiktok.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tumblr_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_tumblr_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-tumblr.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_snapchat_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_snapchat_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-snapchat.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_youtube_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_youtube_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-youtube.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_vimeo_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_vimeo_link }}" class="list-social__link link">
                    <span class="svg-wrapper">
                      {{- 'icon-vimeo.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>
