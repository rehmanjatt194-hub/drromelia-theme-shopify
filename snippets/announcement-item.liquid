{% if block.settings.link != blank %}
    <a href="{{ block.settings.link }}"
    class="custom-ann-bar__item"
    style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.font_size }}px;">
    {% if block.settings.icon %}
        <img src="{{ block.settings.icon | img_url: 'master' }}">
    {% endif %}
    {{ block.settings.text }}
    </a>
{% else %}
    <div class="custom-ann-bar__item"
    style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.font_size }}px;">
    {% if block.settings.icon %}
        <img src="{{ block.settings.icon | img_url: 'master' }}">
    {% endif %}
    {{ block.settings.text }}
    </div>
{% endif %}