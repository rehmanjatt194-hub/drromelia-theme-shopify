{%- style -%}
  .trust-badges-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background_gradient }};
  }

  .tb-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .tb-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
  }

  .tb-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 30px 20px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(111, 44, 145, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .tb-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(111, 44, 145, 0.15);
  }

  .tb-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f46f9a 0%, #6f2c91 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }

  .tb-icon svg {
    width: 32px;
    height: 32px;
  }

  .tb-title {
    font-size: 16px;
    font-weight: 700;
    color: #15253e;
    margin: 0 0 10px;
  }

  .tb-desc {
    font-size: 13px;
    color: #666666;
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 990px) {
    .tb-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .tb-grid {
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }
    .tb-card {
      padding: 20px 15px;
    }
  }

  @media screen and (max-width: 480px) {
    .tb-grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<section class="trust-badges-{{ section.id }}">
  <div class="tb-container">
    <div class="tb-grid">
      {%- for block in section.blocks -%}
        <div class="tb-card" {{ block.shopify_attributes }}>
          <div class="tb-icon">
            {% case block.settings.icon %}
              {% when 'delivery' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
              {% when 'truck' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              {% when 'return' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
              {% when 'quality' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
              {% when 'support' %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            {% endcase %}
          </div>
          <h3 class="tb-title">{{ block.settings.title }}</h3>
          <p class="tb-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Badges",
  "settings": [
    {
      "type": "text",
      "id": "background_gradient",
      "label": "Background Gradient",
      "default": "linear-gradient(180deg, rgba(244,111,154,0.05) 0%, rgba(111,44,145,0.05) 100%)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "delivery", "label": "Cash (Money)" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "quality", "label": "Shield" },
            { "value": "support", "label": "Chat" }
          ],
          "default": "delivery"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Feature Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "delivery",
            "title": "Cash on Delivery",
            "description": "Pay When You Receive"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "truck",
            "title": "Free Shipping",
            "description": "Free Shipping on Orders Above Rs. 2,999"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "return",
            "title": "7 Days Easy Return",
            "description": "Hassle-Free Exchange"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "quality",
            "title": "100% Original",
            "description": "Premium Quality Guaranteed"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "support",
            "title": "24/7 Customer Support",
            "description": "Always Here to Help"
          }
        }
      ]
    }
  ]
}
{% endschema %}
