{% comment %}
  LX – Info Tabs (Fully Dynamic & Scoped)
{% endcomment %}

<style>
#section-{{ section.id }} {
  background: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.desktop_padding_top }}px;
  padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
}

@media (max-width: 750px) {
  #section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
}

/* ===== Buttons ===== */
#section-{{ section.id }} .LX-tabs-info-btns {
  display: flex;
  justify-content: center;
  gap: {{ section.settings.btn_gap }}px;
  margin-bottom: {{ section.settings.btn_margin_bottom }}px;
}

#section-{{ section.id }} .LX-tabs-info-btn-item {
  padding: {{ section.settings.btn_padding_y }}px {{ section.settings.btn_padding_x }}px;
  border-radius: {{ section.settings.btn_radius }}px;
  border: {{ section.settings.btn_border_width }}px solid {{ section.settings.btn_border_color }};
  background: {{ section.settings.btn_bg }};
  color: {{ section.settings.btn_text_color }};
  font-size: {{ section.settings.btn_font_size }}px;
  cursor: pointer;
  transition: 0.3s;
}

#section-{{ section.id }} .LX-tabs-info-btn-item.active {
  background: {{ section.settings.btn_active_bg }};
  color: {{ section.settings.btn_active_text }};
  border-color: {{ section.settings.btn_active_border }};
}

/* ===== Tabs ===== */
#section-{{ section.id }} .LX-tabs-info-tab-item {
  display: none;
  flex-wrap: wrap;
  gap: {{ section.settings.item_gap }}px;
}

#section-{{ section.id }} .LX-tabs-info-tab-item.active {
  display: flex;
}

#section-{{ section.id }} .LX-tabs-info-tab-item-inner {
  width: calc(100% / {{ section.settings.items_per_row }} - 10px);
  display: flex;
  gap: {{ section.settings.icon_gap }}px;
}

#section-{{ section.id }} .LX-tabs-info-tab-item-inner img {
  width: var(---icon-size);
  height: var(---icon-size);
  object-fit: contain;
}

/* ===== Text ===== */
#section-{{ section.id }} h5 {
  font-size: {{ section.settings.heading_size }}px;
  color: {{ section.settings.heading_color }};
  margin: 0 0 10px;
}

#section-{{ section.id }} .LX-tabs-info-tab-item-text p {
  font-size: {{ section.settings.text_size }}px;
  color: {{ section.settings.text_color }};
  line-height: 120%;
  margin: 0;
}

/* ===== Mobile ===== */
@media (max-width: 750px) {
  #section-{{ section.id }} .LX-tabs-info-btns {
    overflow-x: auto;
    justify-content: flex-start;
  }

  #section-{{ section.id }} .LX-tabs-info-btns::-webkit-scrollbar {
    display: none;
  }

  #section-{{ section.id }} .LX-tabs-info-tab-item {
    overflow-x: auto;
    flex-wrap: nowrap;
  }

  #section-{{ section.id }} .LX-tabs-info-tab-item-inner {
    min-width: 85%;
  }
  .LX-tabs-info-row .page-width {
    padding: 0;
  }
  .LX-tabs-info-tab-item {
    scroll-snap-type: x mandatory;
    }

    .LX-tabs-info-tab-item-inner {
        scroll-snap-align: start;
    }

    .LX-tabs-info-btns {
        scroll-snap-type: x mandatory;
    }

    button.LX-tabs-info-btn-item {
        scroll-snap-align: start;
    }
  .LX-tabs-info-btns {
      scroll-padding-left: 15px;
  }

  button.LX-tabs-info-btn-item:first-child {
      margin-left: 15px;
  }

  button.LX-tabs-info-btn-item:last-child {
      margin-right: 15px;
  }

  .LX-tabs-info-tab-item {scroll-padding-left: 15px;}

  .LX-tabs-info-tab-item-inner:first-child {
      margin-left: 15px;
  }

  .LX-tabs-info-tab-item-inner:last-child {
      margin-right: 15px;
  }

  .LX-tabs-info-tab-item::-webkit-scrollbar {
      display: none;
  }
}
</style>

<div id="section-{{ section.id }}" class="LX-tabs-info-row">
  <div class="page-width">
    <div class="LX-tabs-info-inner-row">

      <!-- Buttons -->
      <div class="LX-tabs-info-btns">
        <button class="LX-tabs-info-btn-item" btn-id="benifit">Benefits</button>
        <button class="LX-tabs-info-btn-item" btn-id="ingredients">Ingredients</button>
        <button class="LX-tabs-info-btn-item" btn-id="usage">Usage</button>
      </div>

      <!-- Tabs -->
      <div class="LX-tabs-info-tabs">

        {% assign tabs = "benifit,ingredients,usage" | split: "," %}

        {% for tab in tabs %}
          <div class="LX-tabs-info-tab-item" tab-id="{{ tab }}">
            {% for block in section.blocks %}
              {% if block.type == tab %}
                <div class="LX-tabs-info-tab-item-inner" style="---icon-size:{{ block.settings.icon_size }}px;">
                  {% if block.settings.icon %}
                    {% render 'lx-liquid-image', image: block.settings.icon %}
                  {% endif %}
                  <div class="LX-tabs-info-tab-item-info" style="text-align: {{ block.settings.align }};">
                    <h5>{{ block.settings.heading }}</h5>
                    <div class="LX-tabs-info-tab-item-text">
                      {{ block.settings.text }}
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endfor %}

      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const section = document.querySelector("#section-{{ section.id }}");
  if (!section) return;

  const buttons = section.querySelectorAll(".LX-tabs-info-btn-item");
  const tabs = section.querySelectorAll(".LX-tabs-info-tab-item");

  if (buttons.length && tabs.length) {
    buttons[0].classList.add("active");
    tabs[0].classList.add("active");
  }

  buttons.forEach(btn => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("btn-id");

      buttons.forEach(b => b.classList.remove("active"));
      tabs.forEach(t => t.classList.remove("active"));

      btn.classList.add("active");
      section.querySelector('[tab-id="' + id + '"]').classList.add("active");
    });
  });
});
</script>

