{%- style -%}
  #Stats-{{ section.id }} {
    --stats-bg-color: {{ section.settings.background_color }};
    --stats-heading-color: {{ section.settings.heading_color }};
    --stats-number-color: {{ section.settings.number_color }};
    --stats-text-color: {{ section.settings.text_color }};
    --stats-heading-size: {{ section.settings.heading_size }}px;
    --stats-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --stats-number-size: {{ section.settings.number_size }}px;
    --stats-number-size-mobile: {{ section.settings.number_size_mobile }}px;
    --stats-text-size: {{ section.settings.text_size }}px;
    --stats-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --stats-padding-top: {{ section.settings.padding_top }}px;
    --stats-padding-bottom: {{ section.settings.padding_bottom }}px;
    --stats-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --stats-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --stats-gap: {{ section.settings.column_gap }}px;
    --stats-gap-mobile: {{ section.settings.column_gap_mobile }}px;
    --stats-max-width: {{ section.settings.max_width }}px;
    --stats-heading-weight: {{ section.settings.heading_font_weight }};
    --stats-number-weight: {{ section.settings.number_font_weight }};
    --stats-text-weight: {{ section.settings.text_font_weight }};
    --stats-item-alignment: {{ section.settings.item_alignment }};
    --stats-heading-alignment: {{ section.settings.heading_alignment }};
  }
{%- endstyle -%}

<section id="Stats-{{ section.id }}" class="stats-difference-section">
  <div class="stats-difference__container">
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} class="stats-difference__heading">
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="stats-difference__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- assign has_stats = false -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.stat_number != blank or block.settings.stat_text != blank -%}
        {%- assign has_stats = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_stats -%}
      <div class="stats-difference__grid stats-difference__grid--{{ section.settings.columns_desktop }}-cols">
        {%- for block in section.blocks -%}
          {%- if block.settings.stat_number != blank or block.settings.stat_text != blank -%}
            <div class="stats-difference__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <div class="stats-difference__icon" style="--icon-size: {{ block.settings.icon_size }}px;">
                  <img 
                    src="{{ block.settings.icon | image_url: width: 200 }}" 
                    alt="{{ block.settings.icon.alt | default: '' }}"
                    width="{{ block.settings.icon_size }}"
                    height="{{ block.settings.icon_size }}"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}
              
              <div class="stats-difference__content">
                {%- if block.settings.stat_number != blank -%}
                  <span class="stats-difference__number" style="{% if block.settings.custom_number_color != blank %}color: {{ block.settings.custom_number_color }};{% endif %}">
                    {{ block.settings.stat_number }}{% if block.settings.stat_suffix != blank %}{{ block.settings.stat_suffix }}{% endif %}
                  </span>
                {%- endif -%}
                
                {%- if block.settings.stat_text != blank -%}
                  <p class="stats-difference__text" style="{% if block.settings.custom_text_color != blank %}color: {{ block.settings.custom_text_color }};{% endif %}">
                    {{ block.settings.stat_text }}
                  </p>
                {%- endif -%}
              </div>

              {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                <a 
                  href="{{ block.settings.button_link }}" 
                  class="stats-difference__button"
                  style="
                    --btn-bg: {{ block.settings.button_bg_color }};
                    --btn-text: {{ block.settings.button_text_color }};
                    --btn-hover-bg: {{ block.settings.button_hover_bg_color }};
                    --btn-hover-text: {{ block.settings.button_hover_text_color }};
                    --btn-border-radius: {{ block.settings.button_border_radius }}px;
                    --btn-padding-x: {{ block.settings.button_padding_horizontal }}px;
                    --btn-padding-y: {{ block.settings.button_padding_vertical }}px;
                    --btn-font-size: {{ block.settings.button_font_size }}px;
                  "
                >
                  {{ block.settings.button_label }}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_button_label != blank and section.settings.cta_button_link != blank -%}
      <div class="stats-difference__cta">
        <a 
          href="{{ section.settings.cta_button_link }}" 
          class="stats-difference__cta-button"
          style="
            --cta-bg: {{ section.settings.cta_button_bg_color }};
            --cta-text: {{ section.settings.cta_button_text_color }};
            --cta-hover-bg: {{ section.settings.cta_button_hover_bg_color }};
            --cta-hover-text: {{ section.settings.cta_button_hover_text_color }};
            --cta-border-radius: {{ section.settings.cta_button_border_radius }}px;
            --cta-padding-x: {{ section.settings.cta_button_padding_horizontal }}px;
            --cta-padding-y: {{ section.settings.cta_button_padding_vertical }}px;
            --cta-font-size: {{ section.settings.cta_button_font_size }}px;
          "
        >
          {{ section.settings.cta_button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .stats-difference-section {
    background-color: var(--stats-bg-color);
    padding-top: var(--stats-padding-top);
    padding-bottom: var(--stats-padding-bottom);
  }

  .stats-difference__container {
    max-width: var(--stats-max-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  .stats-difference__heading {
    font-size: var(--stats-heading-size);
    color: var(--stats-heading-color);
    font-weight: var(--stats-heading-weight);
    text-align: var(--stats-heading-alignment);
    margin: 0 0 20px 0;
    line-height: 1.2;
  }

  .stats-difference__subheading {
    font-size: calc(var(--stats-text-size) * 1.1);
    color: var(--stats-text-color);
    text-align: var(--stats-heading-alignment);
    margin: 0 0 40px 0;
    opacity: 0.8;
  }

  .stats-difference__grid {
    display: grid;
    gap: var(--stats-gap);
  }

  .stats-difference__grid--2-cols {
    grid-template-columns: repeat(2, 1fr);
  }

  .stats-difference__grid--3-cols {
    grid-template-columns: repeat(3, 1fr);
  }

  .stats-difference__grid--4-cols {
    grid-template-columns: repeat(4, 1fr);
  }

  .stats-difference__item {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 20px;
    text-align: var(--stats-item-alignment);
  }

  .stats-difference__icon {
    flex-shrink: 0;
    width: var(--icon-size);
    height: var(--icon-size);
  }

  .stats-difference__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .stats-difference__content {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 15px;
  }

  .stats-difference__number {
    font-size: var(--stats-number-size);
    color: var(--stats-number-color);
    font-weight: var(--stats-number-weight);
    line-height: 1;
    flex-shrink: 0;
  }

  .stats-difference__text {
    font-size: var(--stats-text-size);
    color: var(--stats-text-color);
    font-weight: var(--stats-text-weight);
    line-height: 1.5;
    margin: 0;
    padding-top: 5px;
  }

  .stats-difference__button {
    display: inline-block;
    background-color: var(--btn-bg);
    color: var(--btn-text);
    border-radius: var(--btn-border-radius);
    padding: var(--btn-padding-y) var(--btn-padding-x);
    font-size: var(--btn-font-size);
    text-decoration: none;
    transition: all 0.3s ease;
    margin-top: 15px;
  }

  .stats-difference__button:hover {
    background-color: var(--btn-hover-bg);
    color: var(--btn-hover-text);
  }

  .stats-difference__cta {
    text-align: center;
    margin-top: 50px;
  }

  .stats-difference__cta-button {
    display: inline-block;
    background-color: var(--cta-bg);
    color: var(--cta-text);
    border-radius: var(--cta-border-radius);
    padding: var(--cta-padding-y) var(--cta-padding-x);
    font-size: var(--cta-font-size);
    text-decoration: none;
    transition: all 0.3s ease;
    font-weight: 600;
  }

  .stats-difference__cta-button:hover {
    background-color: var(--cta-hover-bg);
    color: var(--cta-hover-text);
  }

  /* Responsive Styles */
  @media screen and (max-width: 991px) {
    .stats-difference__grid--4-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 767px) {
    .stats-difference-section {
      padding-top: var(--stats-padding-top-mobile);
      padding-bottom: var(--stats-padding-bottom-mobile);
    }

    .stats-difference__heading {
      font-size: var(--stats-heading-size-mobile);
    }

    .stats-difference__number {
      font-size: var(--stats-number-size-mobile);
    }

    .stats-difference__text {
      font-size: var(--stats-text-size-mobile);
    }

    .stats-difference__grid {
      gap: var(--stats-gap-mobile);
    }

    .stats-difference__grid--2-cols,
    .stats-difference__grid--3-cols,
    .stats-difference__grid--4-cols {
      grid-template-columns: 1fr;
    }

    .stats-difference__item {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .stats-difference__content {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .stats-difference__text {
      padding-top: 0;
    }
  }
</style>

