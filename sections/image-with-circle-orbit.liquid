<style>
#section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
}
.pf-split-section {
    overflow: hidden;
}
.pf-subtext.rich-text-content h4 {
    font-weight: 400;
    font-size: 18px;
    margin: 0;
}
@media (max-width: 750px) {
  #section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px !important;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px !important;
  }
}
</style>

<section id="section-{{ section.id }}" class="pf-split-section  color-{{ section.settings.color_scheme }} isolate gradient pf-split-section---animation {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="page-width">
    <div class="pf-row
      {% if section.settings.image_position == 'left' %}pf-image-left{% else %}pf-image-right{% endif %}
    ">
      {% if section.settings.image != blank %}
      <div class="pf-col pf-image-col" role="img" aria-label="{{ section.settings.image_alt }}">
        <div class="pf-circle-container">
          <!-- Three Concentric Circle Rings -->
          <div class="pf-orbit-ring pf-ring-1"></div>
          <div class="pf-orbit-ring pf-ring-2"></div>
          <div class="pf-orbit-ring pf-ring-3">
            <!-- Orbit Badges on the outermost ring -->
            <div class="pf-orbit-track {% if section.settings.enable_rotation %}pf-rotating{% endif %}">
              {% if section.settings.badge_1_text != blank %}
              <div class="pf-orbit-badge pf-badge-1">
                {% if section.settings.badge_1_icon != blank %}
                  <img src="{{ section.settings.badge_1_icon | img_url: '40x40' }}" alt="" class="pf-badge-icon" />
                {% endif %}
                <span class="pf-badge-text">{{ section.settings.badge_1_text }}</span>
              </div>
              {% endif %}
              
              {% if section.settings.badge_2_text != blank %}
              <div class="pf-orbit-badge pf-badge-2">
                {% if section.settings.badge_2_icon != blank %}
                  <img src="{{ section.settings.badge_2_icon | img_url: '40x40' }}" alt="" class="pf-badge-icon" />
                {% endif %}
                <span class="pf-badge-text">{{ section.settings.badge_2_text }}</span>
              </div>
              {% endif %}
              
              {% if section.settings.badge_3_text != blank %}
              <div class="pf-orbit-badge pf-badge-3">
                {% if section.settings.badge_3_icon != blank %}
                  <img src="{{ section.settings.badge_3_icon | img_url: '40x40' }}" alt="" class="pf-badge-icon" />
                {% endif %}
                <span class="pf-badge-text">{{ section.settings.badge_3_text }}</span>
              </div>
              {% endif %}
            </div>
          </div>
          
          <!-- Product Image -->
          <div class="pf-image-wrap">
            <img src="{{ section.settings.image | img_url: 'master' }}" alt="{{ section.settings.image_alt | escape }}" />
          </div>
        </div>
      </div>
      {% endif %}
      
      <div class="pf-col pf-content-col">
        <div class="pf-content-inner" style="max-width: {{ section.settings.container_width }}px;">
          {% if section.settings.kicker != blank %}
            <div class="pf-kicker">{{ section.settings.kicker }}</div>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="pf-heading" style="
              font-size: {{ section.settings.heading_size }}px;
              font-weight: {{ section.settings.heading_weight }};
              ">
              {{ section.settings.heading | escape }}
            </h2>
          {% endif %}
          {% if section.settings.subtext != blank %}
            <div class="pf-subtext rich-text-content">
              {{ section.settings.subtext }}
            </div>
          {% endif %}
          {% if section.blocks.size > 0 %}
            <ul class="pf-list">
              {% for block in section.blocks %}
                {% if block.settings.text != blank %}
                  <li class="pf-list-item">
                    <div class="pf-list-icon">
                      {% if block.settings.icon != blank %}
                        <img src="{{ block.settings.icon | img_url: '40x40' }}" alt="icon-{{ forloop.index }}" />
                      {% else %}
                        <span class="pf-list-bullet" aria-hidden="true">✓</span>
                      {% endif %}
                    </div>
                    <div class="pf-list-text rich-text-content">
                      {{ block.settings.text }}
                    </div>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
          {% if section.settings.button_text != blank %}
            <a href="{{ section.settings.button_link }}" class="pf-btn button lx-hover-global" data-hover="{{ settings.hover_effect }}" style="
              font-size: {{ section.settings.button_size }}px;
              ">
              {{ section.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  
  <style>
    .pf-list-icon img {
        width: 13px;
        height: 13px;
    }
    a.pf-btn {
        transition: 0.5s ease;
        border: 1px solid;
    }
    .pf-list-icon {
        display: flex;
        align-items: center;
    }
    
    .rich-text-content p strong {
        font-weight: 500;
        display: flex;
        margin-bottom: 8px;
    }
    .pf-list-text.rich-text-content {
        margin: 0;
    }
    .pf-list-text.rich-text-content p {
        margin: 0;
    }
    .pf-row{display:flex;align-items:center;gap:40px;flex-wrap:nowrap;}
    .pf-col{flex:1}
    .pf-image-col{display:flex;justify-content:center;align-items:center}
    .pf-kicker{font-size:14px;color:#6b6b6b;margin-bottom:8px;}
    .pf-heading{margin:0 0 16px 0;line-height:1.1;}
    {% comment %} .pf-list-text p{color:{{ section.settings.body_text_color }};} {% endcomment %}
    .rich-text-content{
        {% comment %} color:{{ section.settings.body_text_color }}; {% endcomment %}
        font-size:{{ section.settings.body_text_size }}px;
        margin-bottom:16px;
        line-height: 135%;
        letter-spacing: 0;
    }
    .pf-list{list-style:none;padding:0;margin:0 0 20px 0;display:flex;flex-direction:column;gap:12px;}
    .pf-list-item{display:flex;align-items:center;gap:7px;}
    .pf-list-icon img{object-fit:contain;}
    .pf-list-bullet{display:inline-block;width:36px;height:36px;border-radius:50%;border:1px solid #ccc;display:flex;align-items:center;justify-content:center;font-weight:700;}
    .pf-list-text{font-size:14px;color:inherit;}
    .pf-btn{display:inline-block;padding:12px 22px;text-decoration:none;box-shadow:none;}
    .pf-image-left{flex-direction:row-reverse;}
    .pf-image-right{flex-direction:row;}
    .pf-heading em{font-style:italic;color: {{ section.settings.heading_em_color }};}

    /* Circle Container & Orbit Styles */
    .pf-circle-container {
        position: relative;
        width: 100%;
        max-width: 550px;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    /* Base styles for all orbit rings */
    .pf-orbit-ring {
        position: absolute;
        border: {{ section.settings.circle_border_width }}px solid {{ section.settings.circle_color }};
        border-radius: 50%;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
    
    /* Circle 1 - Smallest (innermost) */
    .pf-ring-1 {
        width: {{ section.settings.circle_1_size }}%;
        height: {{ section.settings.circle_1_size }}%;
        border-color: {{ section.settings.circle_1_color }};
    }
    
    /* Circle 2 - Medium */
    .pf-ring-2 {
        width: {{ section.settings.circle_2_size }}%;
        height: {{ section.settings.circle_2_size }}%;
        border-color: {{ section.settings.circle_2_color }};
    }
    
    /* Circle 3 - Largest (outermost) - badges orbit here */
    .pf-ring-3 {
        width: {{ section.settings.circle_3_size }}%;
        height: {{ section.settings.circle_3_size }}%;
        border-color: {{ section.settings.circle_3_color }};
    }
    
    .pf-orbit-track {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
    }
    
    .pf-orbit-track.pf-rotating {
        animation: orbitRotate {{ section.settings.rotation_speed }}s linear infinite;
    }
    
    @keyframes orbitRotate {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
    
    /* Counter-rotation for badges to keep text readable */
    @keyframes counterRotate {
        from {
            transform: translate(-50%, -50%) rotate(0deg);
        }
        to {
            transform: translate(-50%, -50%) rotate(-360deg);
        }
    }
    
    .pf-orbit-badge {
        position: absolute;
        background: {{ section.settings.badge_bg_color }};
        border: 1px solid {{ section.settings.badge_border_color }};
        border-radius: 50px;
        padding: 8px 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        white-space: nowrap;
        z-index: 10;
    }
    
    .pf-rotating .pf-orbit-badge {
        animation: counterRotate {{ section.settings.rotation_speed }}s linear infinite;
    }
    
    .pf-badge-icon {
        width: 18px;
        height: 18px;
        object-fit: contain;
    }
    
    .pf-badge-emoji {
        font-size: 16px;
        line-height: 1;
    }
    
    .pf-badge-text {
        font-size: {{ section.settings.badge_font_size }}px;
        font-weight: 500;
        color: {{ section.settings.badge_text_color }};
    }
    
    /* Badge Positions - evenly distributed around the outermost circle */
    .pf-badge-1 {
        top: 5%;
        left: 70%;
        transform: translate(-50%, -50%);
    }
    
    .pf-badge-2 {
        top: 50%;
        left: 105%;
        transform: translate(-50%, -50%);
    }
    
    .pf-badge-3 {
        top: 95%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
    
    /* Product Image Styles */
    .pf-split-section---animation .pf-image-wrap {
        position: relative;
        z-index: 5;
        max-width: 70%;
    }
    
    .pf-image-wrap img {
        max-width: 100%;
        height: auto;
        display: block;
    }

    /* Mobile Responsive */
    @media (max-width: 991px) {
      .pf-circle-container {
          max-width: 450px;
      }
      .pf-orbit-badge {
          padding: 6px 12px;
      }
      .pf-badge-text {
          font-size: 12px !important;
      }
      .pf-split-section---animation .pf-row.pf-image-left {
          flex-direction: column;
      }
    }
    
    @media (max-width: 767px){
      .pf-row{flex-direction:column;align-items:stretch;gap:30px;}
      .pf-image-col{order: -1;} 
      .pf-content-inner{padding:0 0px;}
      .pf-heading{font-size:24px !important;}
      .rich-text-content{font-size:15px !important;}
      .pf-list{gap:10px;}
      .pf-list-text{font-size:14px;}
      .pf-container{padding:24px 16px;}
      
      .pf-circle-container {
          max-width: 350px;
          margin: 0 auto;
      }
      
      .pf-orbit-badge {
          padding: 5px 10px;
          gap: 5px;
      }
      
      .pf-badge-text {
          font-size: 11px !important;
      }
      
      .pf-badge-icon {
          width: 14px;
          height: 14px;
      }
      
      .pf-badge-emoji {
          font-size: 12px;
      }
      
      .pf-badge-1 {
          top: 0%;
          left: 65%;
      }
      
      .pf-badge-2 {
          top: 45%;
          left: 100%;
      }
      
      .pf-badge-3 {
          top: 90%;
          left: 55%;
      }
    }
    
    @media (max-width: 480px) {
      .pf-circle-container {
          max-width: 300px;
      }
      
      .pf-orbit-badge {
          padding: 4px 8px;
      }
      
      .pf-badge-text {
          font-size: 10px !important;
      }
    }

    .pf-orbit-ring {
        display: block !important;
    }
  </style>
</section>

{% schema %}
{
  "name": "Image with Circle Orbit",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Circle 1 Settings (Innermost - Smallest)"
    },
    {
      "type": "range",
      "id": "circle_1_size",
      "min": 30,
      "max": 60,
      "step": 2,
      "label": "Circle 1 size (%)",
      "default": 40
    },
    {
      "type": "color",
      "id": "circle_1_color",
      "label": "Circle 1 color",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Circle 2 Settings (Middle)"
    },
    {
      "type": "range",
      "id": "circle_2_size",
      "min": 50,
      "max": 80,
      "step": 2,
      "label": "Circle 2 size (%)",
      "default": 66
    },
    {
      "type": "color",
      "id": "circle_2_color",
      "label": "Circle 2 color",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Circle 3 Settings (Outermost - Largest)"
    },
    {
      "type": "range",
      "id": "circle_3_size",
      "min": 70,
      "max": 100,
      "step": 2,
      "label": "Circle 3 size (%)",
      "default": 90
    },
    {
      "type": "color",
      "id": "circle_3_color",
      "label": "Circle 3 color",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Circle Border & Rotation"
    },
    {
      "type": "range",
      "id": "circle_border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Circle border width (px)",
      "default": 2
    },
    {
      "type": "color",
      "id": "circle_color",
      "label": "Default circle color (fallback)",
      "default": "#e0e0e0"
    },
    {
      "type": "checkbox",
      "id": "enable_rotation",
      "label": "Enable badge rotation",
      "default": true
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "label": "Rotation speed (seconds)",
      "default": 30,
      "info": "Lower = faster rotation"
    },
    {
      "type": "header",
      "content": "Badge 1 (Top Right)"
    },
    {
      "type": "text",
      "id": "badge_1_text",
      "label": "Badge 1 text",
      "default": "85+ Essential Minerals"
    },
    {
      "type": "image_picker",
      "id": "badge_1_icon",
      "label": "Badge 1 icon (optional)"
    },
    {
      "type": "header",
      "content": "Badge 2 (Right)"
    },
    {
      "type": "text",
      "id": "badge_2_text",
      "label": "Badge 2 text",
      "default": "100% Natural & Pure"
    },
    {
      "type": "image_picker",
      "id": "badge_2_icon",
      "label": "Badge 2 icon (optional)"
    },
    {
      "type": "header",
      "content": "Badge 3 (Bottom)"
    },
    {
      "type": "text",
      "id": "badge_3_text",
      "label": "Badge 3 text",
      "default": "Supports Energy & Recovery"
    },
    {
      "type": "image_picker",
      "id": "badge_3_icon",
      "label": "Badge 3 icon (optional)"
    },
    {
      "type": "header",
      "content": "Badge Styling"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_border_color",
      "label": "Badge border color",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "label": "Badge font size (px)",
      "default": 13
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker (small pre-heading)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "INTRODUCING SHILAJIT CAPSULES"
    },
    {
      "type": "number",
      "id": "heading_size",
      "label": "Heading size (px)",
      "default": 32
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Normal (400)" },
        { "value": "600", "label": "Semi-bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "heading_em_color",
      "label": "Emphasized word color (em tag)",
      "default": "#166633"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext (rich text)",
      "default": "<p>Nature's Purest Energy in Every Capsule</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "product image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position on desktop",
      "options": [
        { "value": "right", "label": "Right (default)" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "number",
      "id": "container_width",
      "label": "Max content width (px)",
      "default": 540
    },
    {
      "type": "number",
      "id": "body_text_size",
      "label": "Body text size (px)",
      "default": 15
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Unlock Your Daily Strength"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "number",
      "id": "button_size",
      "label": "Button font size (px)",
      "default": 15
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "label": "Desktop padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "label": "Desktop padding bottom",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "label": "Mobile padding top",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "label": "Mobile padding bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image (optional)"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Feature text (richtext)",
          "default": "<p>100% natural energy release</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Image with Circle Orbit"
    }
  ]
}
{% endschema %}

