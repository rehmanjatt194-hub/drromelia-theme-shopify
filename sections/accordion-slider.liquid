{{ 'accordion-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .accordion-slider-section--{{ section.id }} {
    --section-bg: {{ section.settings.section_background }};
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    
    --heading-size: {{ section.settings.heading_size }}px;
    --heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --heading-font-weight: {{ section.settings.heading_font_weight }};
    
    --card-bg: {{ section.settings.card_background }};
    --card-radius: {{ section.settings.card_border_radius }}px;
    --card-title-color: {{ section.settings.card_title_color }};
    --card-title-size: {{ section.settings.card_title_size }}px;
    --card-title-size-mobile: {{ section.settings.card_title_size_mobile }}px;
    --card-title-font-weight: {{ section.settings.card_title_font_weight }};
    --card-content-color: {{ section.settings.card_content_color }};
    --card-content-size: {{ section.settings.card_content_size }}px;
    --card-content-size-mobile: {{ section.settings.card_content_size_mobile }}px;
    
    --toggle-btn-bg: {{ section.settings.toggle_button_background }};
    --toggle-btn-color: {{ section.settings.toggle_button_color }};
    --toggle-btn-size: {{ section.settings.toggle_button_size }}px;
    --toggle-btn-icon-size: {{ section.settings.toggle_button_icon_size }}px;
    
    --image-height: {{ section.settings.image_height }}px;
    --image-height-mobile: {{ section.settings.image_height_mobile }}px;
    --image-radius: {{ section.settings.image_border_radius }}px;
    
    --arrow-bg: {{ section.settings.arrow_background }};
    --arrow-color: {{ section.settings.arrow_color }};
    --arrow-size: {{ section.settings.arrow_size }}px;
    
    --progress-bg: {{ section.settings.progress_bar_background }};
    --progress-fill: {{ section.settings.progress_bar_fill }};
    --progress-height: {{ section.settings.progress_bar_height }}px;
    
    --dots-color: {{ section.settings.dots_color }};
    --dots-active-color: {{ section.settings.dots_active_color }};
  }
  .accordion-slider-section--{{ section.id }} {
    background: {{ section.settings.bg_color }};
  }
{%- endstyle -%}

<div class="accordion-slider-section  color-{{ section.settings.color_scheme }} isolate gradient  accordion-slider-section--{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="page-width {% if section.settings.full_width %}full-width{% endif %}">
    <div class="accordion-slider---inner-row">
    {%- if section.settings.section_heading != blank -%}
      <div class="accordion-slider-header">
        <{{ section.settings.heading_tag }} class="accordion-slider-heading">
          {{ section.settings.section_heading }}
        </{{ section.settings.heading_tag }}>
        
        {%- if section.settings.section_subheading != blank -%}
          <p class="accordion-slider-subheading" style="font-size: {{ section.settings.subheading_size }}px;">
            {{ section.settings.section_subheading }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="slider-wrapper accordion-slider-wrapper">
      <swiper-container 
        init="false" 
        class="js-swiper-template accordion-swiper"
        data-swiper-config='{
          "autoplay": {{ section.settings.enable_autoplay | default: false }},
          "autoplayInterval": {{ section.settings.autoplay_interval | times: 1000 | default: 3000 }},
          "mobileSlides": {{ section.settings.mobile_slides | default: 1.2 }},
          "mobileSpacing": {{ section.settings.mobile_spacing | default: 16 }},
          "desktopSlides": {{ section.settings.desktop_slides | default: 3 }},
          "desktopSpacing": {{ section.settings.desktop_spacing | default: 24 }}
        }'
      >
        {%- for block in section.blocks -%}
          <swiper-slide {{ block.shopify_attributes }}>
            <div class="accordion-card {% if block.settings.default_open %}is-open{% endif %}" data-accordion-card>
              {%- if block.settings.card_image != blank -%}
                <div class="accordion-card-image">
                  <img 
                    src="{{ block.settings.card_image | image_url: width: 800 }}"
                    srcset="{{ block.settings.card_image | image_url: width: 400 }} 400w,
                            {{ block.settings.card_image | image_url: width: 600 }} 600w,
                            {{ block.settings.card_image | image_url: width: 800 }} 800w"
                    sizes="(max-width: 767px) 90vw, 400px"
                    alt="{{ block.settings.card_image.alt | default: block.settings.card_title | escape }}"
                    loading="lazy"
                    width="{{ block.settings.card_image.width }}"
                    height="{{ block.settings.card_image.height }}"
                  >
                </div>
              {%- else -%}
                <div class="accordion-card-image accordion-card-image--placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
              
              <div class="accordion-card-content">
                <div class="accordion-card-header">
                  {%- if block.settings.card_title != blank -%}
                    <h3 class="accordion-card-title">{{ block.settings.card_title }}</h3>
                  {%- endif -%}
                  
                  <button type="button" class="accordion-toggle-btn" aria-expanded="{% if block.settings.default_open %}true{% else %}false{% endif %}" aria-label="Toggle accordion">
                    <span class="toggle-icon toggle-icon--plus">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </span>
                    <span class="toggle-icon toggle-icon--minus">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                    </span>
                  </button>
                </div>
                
                {%- if block.settings.card_content != blank -%}
                  <div class="accordion-card-body">
                    <div class="accordion-card-body-inner">
                      {{ block.settings.card_content }}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </swiper-slide>
        {%- endfor -%}
      </swiper-container>

      <div class="swiper-custom-controls">
        <div class="swiper-custom-prev swiper-custom-arrow 
          {% unless section.settings.mobile_arrows %}hide-on-mobile{% endunless %} 
          {% unless section.settings.desktop_arrows %}hide-on-desktop{% endunless %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </div>
        
        <div class="swiper-custom-pagination 
          {% unless section.settings.mobile_dots %}hide-on-mobile{% endunless %} 
          {% unless section.settings.desktop_dots %}hide-on-desktop{% endunless %}">
        </div>
        
        <div class="swiper-custom-next swiper-custom-arrow 
          {% unless section.settings.mobile_arrows %}hide-on-mobile{% endunless %} 
          {% unless section.settings.desktop_arrows %}hide-on-desktop{% endunless %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
      </div>

      <div class="swiper-custom-scrollbar
        {% unless section.settings.mobile_scrollbar %}hide-on-mobile{% endunless %} 
        {% unless section.settings.desktop_scrollbar %}hide-on-desktop{% endunless %}">
      </div>

      <div class="swiper-progress-track
        {% unless section.settings.mobile_progress_bar %}hide-on-mobile{% endunless %} 
        {% unless section.settings.desktop_progress_bar %}hide-on-desktop{% endunless %}">
        <div class="swiper-progress-fill"></div>
      </div>
    </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const section = document.querySelector('.accordion-slider-section--{{ section.id }}');
    
    function initAccordion() {
      if (!section) return;
      
      const cards = section.querySelectorAll('[data-accordion-card]');
      
      cards.forEach(card => {
        const toggleBtn = card.querySelector('.accordion-toggle-btn');
        
        if (toggleBtn) {
          toggleBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            
            const isOpen = card.classList.contains('is-open');
            
            {%- if section.settings.accordion_behavior == 'single' -%}
              // Close all other accordions in this section
              cards.forEach(otherCard => {
                if (otherCard !== card) {
                  otherCard.classList.remove('is-open');
                  const otherBtn = otherCard.querySelector('.accordion-toggle-btn');
                  if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                }
              });
            {%- endif -%}
            
            card.classList.toggle('is-open');
            toggleBtn.setAttribute('aria-expanded', !isOpen);
          });
        }
      });
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAccordion);
    } else {
      initAccordion();
    }
    
    // Shopify editor support
    document.addEventListener('shopify:section:load', (e) => {
      if (e.target.contains(section)) {
        initAccordion();
        templateSliderManager.init();
      }
    });
    
    document.addEventListener('shopify:block:select', (e) => {
      const block = section.querySelector(`[data-shopify-editor-block="${e.detail.blockId}"]`);
      if (block) {
        const card = block.querySelector('[data-accordion-card]');
        if (card) {
          card.classList.add('is-open');
          const btn = card.querySelector('.accordion-toggle-btn');
          if (btn) btn.setAttribute('aria-expanded', 'true');
        }
      }
    });
  })();
</script>

