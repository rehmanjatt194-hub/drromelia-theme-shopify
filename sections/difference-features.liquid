{%- style -%}
  .difference-features-{{ section.id }} {
    --df-section-padding-top: {{ section.settings.padding_top }}px;
    --df-section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --df-section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --df-section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --df-heading-size: {{ section.settings.heading_size }}px;
    --df-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --df-heading-font-weight: {{ section.settings.heading_font_weight }};
    --df-accent-color: {{ section.settings.accent_color }};
    --df-accent-font-style: {{ section.settings.accent_font_style }};
    --df-accent-font-weight: {{ section.settings.accent_font_weight }};
    --df-icon-size: {{ section.settings.icon_size }}px;
    --df-icon-size-mobile: {{ section.settings.icon_size_mobile }}px;
    --df-icon-color: {{ section.settings.icon_color }};
    --df-text-size: {{ section.settings.text_size }}px;
    --df-text-size-mobile: {{ section.settings.text_size_mobile }}px;
    --df-text-line-height: {{ section.settings.text_line_height }};
    --df-card-gap: {{ section.settings.card_gap }}px;
    --df-card-gap-mobile: {{ section.settings.card_gap_mobile }}px;
    --df-card-padding: {{ section.settings.card_padding }}px;
    --df-card-padding-mobile: {{ section.settings.card_padding_mobile }}px;
    --df-card-bg: {{ section.settings.card_background }};
    --df-card-border-radius: {{ section.settings.card_border_radius }}px;
    --df-max-width: {{ section.settings.max_width }}px;
    --df-columns-desktop: {{ section.settings.columns_desktop }};
    --df-columns-tablet: {{ section.settings.columns_tablet }};
    --df-columns-mobile: {{ section.settings.columns_mobile }};
    --df-icon-spacing: {{ section.settings.icon_spacing }}px;
    --df-title-color: {{ section.settings.card_title_color }};
    --df-title-size: {{ section.settings.card_title_size }}px;
    --df-title-size-mobile: {{ section.settings.card_title_size_mobile }}px;
    --df-title-font-weight: {{ section.settings.card_title_font_weight }};
    --df-title-spacing: {{ section.settings.card_title_spacing }}px;
  }

  .difference-features-{{ section.id }} .df-section {
    padding-top: var(--df-section-padding-top);
    padding-bottom: var(--df-section-padding-bottom);
  }

  .difference-features-{{ section.id }} .df-container {
    max-width: var(--df-max-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  .difference-features-{{ section.id }} .df-heading-wrapper {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: {{ section.settings.heading_margin_bottom }}px;
  }

  .difference-features-{{ section.id }} .df-heading {
    font-size: var(--df-heading-size);
    font-weight: var(--df-heading-font-weight);
    line-height: 1.2;
    margin: 0;
  }

  .difference-features-{{ section.id }} .df-heading .accent {
    color: var(--df-accent-color);
    font-style: var(--df-accent-font-style);
    font-weight: var(--df-accent-font-weight);
  }

  .difference-features-{{ section.id }} .df-subheading {
    font-size: calc(var(--df-text-size) + 2px);
    margin-top: 10px;
    opacity: 0.85;
  }

  /* Grid Layout (Non-Slider) */
  .difference-features-{{ section.id }} .df-grid {
    display: grid;
    grid-template-columns: repeat(var(--df-columns-desktop), 1fr);
    gap: var(--df-card-gap);
  }

  .difference-features-{{ section.id }} .df-card {
    text-align: {{ section.settings.card_alignment }};
    padding: 0 var(--df-card-padding);
    background-color: var(--df-card-bg);
    border-radius: var(--df-card-border-radius);
    {% if section.settings.card_border_width > 0 %}
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    {% endif %}
    {% if section.settings.card_shadow %}
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    {% endif %}
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  {% if section.settings.card_hover_effect %}
  .difference-features-{{ section.id }} .df-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }
  {% endif %}

  .difference-features-{{ section.id }} .df-icon-wrapper {
    margin-bottom: var(--bottom-space);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .difference-features-{{ section.id }} .df-icon-wrapper img,
  .difference-features-{{ section.id }} .df-icon-wrapper svg {
    width: var(--desktop-size);
    height: var(--desktop-size);
    object-fit: contain;
  }

  .difference-features-{{ section.id }} .df-icon-wrapper svg {
    color: var(--df-icon-color);
  }

  .difference-features-{{ section.id }} .df-card-title {
    color: var(--df-title-color);
    font-size: var(--df-title-size);
    font-weight: var(--df-title-font-weight);
    margin: 0 0 var(--df-title-spacing) 0;
    line-height: 1.3;
  }

  .difference-features-{{ section.id }} .df-card-text {
    font-size: var(--df-text-size);
    line-height: var(--df-text-line-height);
    margin: 0;
  }

  /* Slider Styles */
  .difference-features-{{ section.id }} .slider-wrapper {
    position: relative;
  }

  .difference-features-{{ section.id }} swiper-slide {
    height: auto;
  }

  .difference-features-{{ section.id }} swiper-slide .df-card {
    height: 100%;
  }

  .difference-features-{{ section.id }} .swiper-custom-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 24px;
  }

  .difference-features-{{ section.id }} .swiper-custom-arrow {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: {{ section.settings.arrow_bg_color }};
    border: 1px solid {{ section.settings.arrow_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .difference-features-{{ section.id }} .swiper-custom-arrow:hover {
    background: {{ section.settings.arrow_hover_bg_color }};
  }

  .difference-features-{{ section.id }} .swiper-custom-arrow svg {
    color: {{ section.settings.arrow_color }};
  }

  .difference-features-{{ section.id }} .swiper-custom-pagination {
    display: flex;
    gap: 8px;
  }

  .difference-features-{{ section.id }} .swiper-custom-pagination .swiper-pagination-bullet {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: {{ section.settings.dot_color }};
    opacity: 0.4;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .difference-features-{{ section.id }} .swiper-custom-pagination .swiper-pagination-bullet-active {
    opacity: 1;
    background: {{ section.settings.dot_active_color }};
  }

  .difference-features-{{ section.id }} .swiper-custom-scrollbar {
    height: 4px;
    background: rgba(0, 0, 0, 0.1);
    border-radius: 2px;
    margin-top: 20px;
  }

  .difference-features-{{ section.id }} .swiper-progress-track {
    height: 4px;
    background: {{ section.settings.progress_track_color }};
    border-radius: 2px;
    margin-top: 20px;
    overflow: hidden;
  }

  .difference-features-{{ section.id }} .swiper-progress-fill {
    height: 100%;
    background: {{ section.settings.progress_fill_color }};
    border-radius: 2px;
    width: 0;
    transition: width 0.3s ease;
  }

  /* Hide utilities */
  .difference-features-{{ section.id }} .hide-on-mobile {
    display: none;
  }

  /* .difference-features-{{ section.id }} .hide-on-desktop {
    display: flex;
  } */

  /* Layout visibility for desktop/mobile slider options */
  .difference-features-{{ section.id }} .df-layout-desktop-only {
    display: none;
  }

  .difference-features-{{ section.id }} .df-layout-mobile-only {
    display: block;
  }

  .difference-features-{{ section.id }} .df-layout-mobile-only.slider-wrapper {
    display: block;
  }

  .difference-features-{{ section.id }} .df-layout-mobile-only.df-grid {
    display: grid;
  }

  /* Tablet Styles */
  @media (min-width: 750px) {
    .difference-features-{{ section.id }} .df-grid {
      grid-template-columns: repeat(var(--df-columns-tablet), 1fr);
    }
  }

  /* Desktop Styles */
  @media (min-width: 990px) {
    .difference-features-{{ section.id }} .df-grid {
      grid-template-columns: repeat(var(--df-columns-desktop), 1fr);
    }

    .difference-features-{{ section.id }} .hide-on-mobile {
      display: flex;
    }

    .difference-features-{{ section.id }} .hide-on-desktop {
      display: none;
    }

    .difference-features-{{ section.id }} .df-layout-desktop-only {
      display: block;
    }

    .difference-features-{{ section.id }} .df-layout-desktop-only.slider-wrapper {
      display: block;
    }

    .difference-features-{{ section.id }} .df-layout-desktop-only.df-grid {
      display: grid;
    }

    .difference-features-{{ section.id }} .df-layout-mobile-only {
      display: none !important;
    }
  }

  /* Mobile Styles */
  @media (max-width: 749px) {
    .difference-features-{{ section.id }} .df-section {
      padding-top: var(--df-section-padding-top-mobile);
      padding-bottom: var(--df-section-padding-bottom-mobile);
    }

    .difference-features-{{ section.id }} .df-heading {
      font-size: var(--df-heading-size-mobile);
    }

    .difference-features-{{ section.id }} .df-grid {
      grid-template-columns: repeat(var(--df-columns-mobile), 1fr);
      gap: var(--df-card-gap-mobile);
    }

    .difference-features-{{ section.id }} .df-card {
      padding: var(--df-card-padding-mobile);
    }

    .difference-features-{{ section.id }} .df-icon-wrapper img,
    .difference-features-{{ section.id }} .df-icon-wrapper svg {
      width: var(--mobile-size);
      height: var(--mobile-size);
    }

    .difference-features-{{ section.id }} .df-card-title {
      font-size: var(--df-title-size-mobile);
    }

    .difference-features-{{ section.id }} .df-card-text {
      font-size: var(--df-text-size-mobile);
    }

    .difference-features-{{ section.id }} .df-container {
      padding: 0 16px;
    }
  }
{%- endstyle -%}

<div class="difference-features-{{ section.id }} color-{{ section.settings.color_scheme }} isolate gradient" data-section-id="{{ section.id }}">
  <section class="df-section">
    <div class="df-container">
      
      {%- comment -%} Heading Section {%- endcomment -%}
      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="df-heading-wrapper">
          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_tag }} class="df-heading">
              {%- if section.settings.accent_text != blank -%}
                {{ section.settings.heading | replace: section.settings.accent_text, '<span class="accent">' | append: section.settings.accent_text | append: '</span>' }}
              {%- else -%}
                {{ section.settings.heading }}
              {%- endif -%}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}
          
          {%- if section.settings.subheading != blank -%}
            <p class="df-subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Check if we have blocks to display {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        
        {%- liquid
          assign slider_desktop = section.settings.enable_slider_desktop
          assign slider_mobile = section.settings.enable_slider_mobile
          assign need_slider = false
          assign need_grid = false
          
          if slider_desktop or slider_mobile
            assign need_slider = true
          endif
          
          if slider_desktop == false or slider_mobile == false
            assign need_grid = true
          endif
          
          assign slider_class = ''
          assign grid_class = ''
          
          if slider_desktop and slider_mobile
            assign slider_class = ''
          elsif slider_desktop and slider_mobile == false
            assign slider_class = 'df-layout-desktop-only'
            assign grid_class = 'df-layout-mobile-only'
          elsif slider_desktop == false and slider_mobile
            assign slider_class = 'df-layout-mobile-only'
            assign grid_class = 'df-layout-desktop-only'
          else
            assign grid_class = ''
          endif
        -%}
        
        {%- comment -%} Slider Layout {%- endcomment -%}
        {%- if need_slider -%}
          <div class="slider-wrapper relative-container {{ slider_class }}">
            <swiper-container 
              init="false" 
              class="js-swiper-template"
              data-swiper-config='{
                "autoplay": {{ section.settings.enable_autoplay | default: false }},
                "autoplayInterval": {{ section.settings.autoplay_interval | times: 1000 | default: 3000 }},
                "mobileSlides": {{ section.settings.mobile_slides | default: 1.2 }},
                "mobileSpacing": {{ section.settings.mobile_spacing | default: 16 }},
                "desktopSlides": {{ section.settings.desktop_slides | default: 3 }},
                "desktopSpacing": {{ section.settings.desktop_spacing | default: 24 }}
              }'
            >
              {%- for block in section.blocks -%}
                <swiper-slide {{ block.shopify_attributes }}>
                  {%- render 'difference-feature-card', 
                    block: block, 
                    section: section
                  -%}
                </swiper-slide>
              {%- endfor -%}
            </swiper-container>
            
            <div class="swiper-custom-controls">
              <div class="swiper-custom-prev swiper-custom-arrow 
                {% unless section.settings.mobile_arrows %}hide-on-mobile{% endunless %} 
                {% unless section.settings.desktop_arrows %}hide-on-desktop{% endunless %}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </div>
              
              <div class="swiper-custom-pagination 
                {% unless section.settings.mobile_dots %}hide-on-mobile{% endunless %} 
                {% unless section.settings.desktop_dots %}hide-on-desktop{% endunless %}">
              </div>
              
              <div class="swiper-custom-next swiper-custom-arrow 
                {% unless section.settings.mobile_arrows %}hide-on-mobile{% endunless %} 
                {% unless section.settings.desktop_arrows %}hide-on-desktop{% endunless %}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </div>
            </div>
            
            <div class="swiper-custom-scrollbar
              {% unless section.settings.mobile_scrollbar %}hide-on-mobile{% endunless %} 
              {% unless section.settings.desktop_scrollbar %}hide-on-desktop{% endunless %}">
            </div>
            
            <div class="swiper-progress-track
              {% unless section.settings.mobile_progress_bar %}hide-on-mobile{% endunless %} 
              {% unless section.settings.desktop_progress_bar %}hide-on-desktop{% endunless %}">
              <div class="swiper-progress-fill"></div>
            </div>
          </div>
        {%- endif -%}
        
        {%- comment -%} Grid Layout {%- endcomment -%}
        {%- if need_grid -%}
          <div class="df-grid {{ grid_class }}">
            {%- for block in section.blocks -%}
              {%- render 'difference-feature-card', 
                block: block, 
                section: section
              -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        
      {%- endif -%}
    </div>
  </section>
</div>

<script>
  document.addEventListener('shopify:section:load', function(e) {
    if (e.detail.sectionId === '{{ section.id }}') {
      if (typeof templateSliderManager !== 'undefined') {
        templateSliderManager.init();
      }
    }
  });
  
  document.addEventListener('shopify:block:select', function(e) {
    const container = document.querySelector(`.difference-features-{{ section.id }} swiper-container`);
    if (container && typeof templateSliderManager !== 'undefined') {
      templateSliderManager.initSingleSlider(container);
    }
  });
</script>

{% schema %}
{
  "name": "Difference Features",
  "tag": "section",
  "class": "section-difference-features",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "📝 Heading Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Difference You Can Feel"
    },
    {
      "type": "text",
      "id": "accent_text",
      "label": "Accent Text (from heading)",
      "info": "Text that will be styled differently. Must match exactly with text in heading.",
      "default": "Feel"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 42
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 18,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Heading Size (Mobile)",
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading Font Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Heading Bottom Margin",
      "default": 50
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Text Color",
      "default": "#2d5a27"
    },
    {
      "type": "select",
      "id": "accent_font_style",
      "label": "Accent Font Style",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "italic", "label": "Italic" }
      ],
      "default": "italic"
    },
    {
      "type": "select",
      "id": "accent_font_weight",
      "label": "Accent Font Weight",
      "options": [
        { "value": "inherit", "label": "Same as Heading" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra Bold" }
      ],
      "default": "inherit"
    },
    {
      "type": "header",
      "content": "🎴 Card Settings"
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Card Padding (Desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding_mobile",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Card Padding (Mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Card Border Width",
      "default": 0
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e0e0e0"
    },
    {
      "type": "checkbox",
      "id": "card_shadow",
      "label": "Enable Card Shadow",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "card_hover_effect",
      "label": "Enable Card Hover Effect",
      "default": false
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Card Gap (Desktop)",
      "default": 30
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Card Gap (Mobile)",
      "default": 20
    },
    {
      "type": "header",
      "content": "📄 Card Title Settings"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Card Title Size (Desktop)",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_title_size_mobile",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Card Title Size (Mobile)",
      "default": 16
    },
    {
      "type": "select",
      "id": "card_title_font_weight",
      "label": "Card Title Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "card_title_spacing",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card Title Bottom Spacing",
