  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FLERE TUSINDE HAR VALGT OS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Stol ikke kun på os, stol på vores community"
    },
    {
      "type": "header",
      "content": "Design Settings"
    },
    {
      "type": "image_picker",
      "id": "star_image",
      "label": "Star Rating Image",
      "info": "Upload your star rating image (e.g., 5 stars)"
    },
    {
