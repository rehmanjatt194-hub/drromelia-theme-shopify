{% comment %}
  Premium Video Showcase Slider - lx-video-showcase.liquid
  A beautiful 3D coverflow video slider with glassmorphism navigation
{% endcomment %}

{%- style -%}
  .lx-vshowcase-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }
  .lx-vshowcase-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba({{ section.settings.accent_color.red }}, {{ section.settings.accent_color.green }}, {{ section.settings.accent_color.blue }}, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }
{%- endstyle -%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<section class="lx-vshowcase lx-vshowcase-{{ section.id }}" id="lx-vshowcase-{{ section.id }}">
  
  {%- if section.settings.heading != blank -%}
    <div class="lx-vshowcase__header">
      {%- if section.settings.subheading != blank -%}
        <p class="lx-vshowcase__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <h2 class="lx-vshowcase__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="lx-vshowcase__desc">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="lx-vshowcase__slider-wrap">

    <!-- Left Arrow -->
    <button class="lx-vshowcase__btn lx-vshowcase__btn--prev" id="lxvs-prev-{{ section.id }}" aria-label="Previous">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="swiper lx-vshowcase__swiper" id="lxvs-swiper-{{ section.id }}">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- if block.type == 'video' -%}
            <div class="swiper-slide lx-vshowcase__slide" {{ block.shopify_attributes }}>
              <div class="lx-vshowcase__card" data-video-type="{{ block.settings.video_type }}" data-video-id="{{ block.settings.video_id }}" data-video-url="{{ block.settings.video_url }}">
                
                <!-- Thumbnail -->
                <div class="lx-vshowcase__thumb">
                  {%- if block.settings.thumbnail != blank -%}
                    <img src="{{ block.settings.thumbnail | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
                  {%- else -%}
                    <div class="lx-vshowcase__thumb-placeholder"></div>
                  {%- endif -%}
                </div>

                <!-- Video (hidden until play) -->
                <div class="lx-vshowcase__video-wrap" style="display:none;">
                  {%- if block.settings.video_type == 'native' and block.settings.video_url != blank -%}
                    <video class="lx-vshowcase__video-el" src="{{ block.settings.video_url }}" playsinline muted loop></video>
                  {%- elsif block.settings.video_type == 'youtube' -%}
                    <iframe class="lx-vshowcase__iframe" src="https://www.youtube.com/embed/{{ block.settings.video_id }}?autoplay=1&mute=1&loop=1&playlist={{ block.settings.video_id }}&playsinline=1" allow="autoplay" allowfullscreen></iframe>
                  {%- elsif block.settings.video_type == 'vimeo' -%}
                    <iframe class="lx-vshowcase__iframe" src="https://player.vimeo.com/video/{{ block.settings.video_id }}?autoplay=1&loop=1&muted=1" allow="autoplay" allowfullscreen></iframe>
                  {%- endif -%}
                </div>

                <!-- Overlay gradient -->
                <div class="lx-vshowcase__overlay"></div>

                <!-- Play Button -->
                <button class="lx-vshowcase__play-btn" aria-label="Play video">
                  <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 5.14v14l11-7-11-7z"/>
                  </svg>
                </button>

                <!-- Mute Button -->
                <button class="lx-vshowcase__mute-btn lx-vshowcase__mute-btn--hidden" aria-label="Toggle mute">
                  <svg class="lx-icon-sound" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11 5L6 9H2v6h4l5 4V5z" stroke="white" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07" stroke="white" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                  <svg class="lx-icon-muted" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:none;">
                    <path d="M11 5L6 9H2v6h4l5 4V5z" stroke="white" stroke-width="2" stroke-linejoin="round"/>
                    <line x1="23" y1="9" x2="17" y2="15" stroke="white" stroke-width="2" stroke-linecap="round"/>
                    <line x1="17" y1="9" x2="23" y2="15" stroke="white" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </button>

                {%- if block.settings.title != blank -%}
                  <div class="lx-vshowcase__card-title">{{ block.settings.title }}</div>
                {%- endif -%}

              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Pagination -->
      <div class="swiper-pagination lx-vshowcase__pagination" id="lxvs-pag-{{ section.id }}"></div>
    </div>

    <!-- Right Arrow -->
    <button class="lx-vshowcase__btn lx-vshowcase__btn--next" id="lxvs-next-{{ section.id }}" aria-label="Next">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

  </div>
</section>

<style>
  .lx-vshowcase__header {
    text-align: center;
    padding: 0 20px 40px;
    max-width: 700px;
    margin: 0 auto;
  }
  .lx-vshowcase__subheading {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: {{ section.settings.accent_color }};
    margin: 0 0 10px;
  }
  .lx-vshowcase__heading {
    font-size: clamp(26px, 4vw, 48px);
    font-weight: 800;
    color: {{ section.settings.text_color }};
    margin: 0 0 14px;
    line-height: 1.2;
  }
  .lx-vshowcase__desc {
    font-size: 15px;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    margin: 0;
    line-height: 1.6;
  }
  .lx-vshowcase__slider-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .lx-vshowcase__swiper {
    width: 100%;
    padding: 40px 0 60px !important;
  }
  .lx-vshowcase__slide {
    width: 260px !important;
    transition: transform 0.4s ease;
  }
  @media screen and (max-width: 768px) {
    .lx-vshowcase__slide { width: 200px !important; }
  }
  @media screen and (max-width: 480px) {
    .lx-vshowcase__slide { width: 165px !important; }
  }
  .lx-vshowcase__card {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    background: #111;
    transition: box-shadow 0.4s ease;
  }
  .swiper-slide-active .lx-vshowcase__card {
    box-shadow: 0 30px 80px rgba(0,0,0,0.6), 0 0 0 3px {{ section.settings.accent_color }};
  }
  .lx-vshowcase__thumb,
  .lx-vshowcase__video-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .lx-vshowcase__thumb img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  .lx-vshowcase__thumb-placeholder {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460);
  }
  .lx-vshowcase__video-el,
  .lx-vshowcase__iframe {
    width: 100%; height: 100%; object-fit: cover; border: none; display: block;
  }
  .lx-vshowcase__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 50%, transparent 100%);
  }
  .lx-vshowcase__play-btn {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 60px; height: 60px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 2px solid rgba(255,255,255,0.5);
    color: white;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 5;
  }
  .lx-vshowcase__play-btn svg { width: 26px; height: 26px; margin-left: 3px; }
  .lx-vshowcase__play-btn:hover {
    background: rgba(255,255,255,0.35);
    transform: translate(-50%, -50%) scale(1.1);
  }
  .lx-vshowcase__play-btn.is-hidden { display: none; }
  .lx-vshowcase__mute-btn {
    position: absolute; top: 14px; right: 14px;
    width: 34px; height: 34px; border-radius: 50%;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255,255,255,0.2);
    color: white;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; z-index: 6; transition: background 0.2s;
  }
  .lx-vshowcase__mute-btn svg { width: 16px; height: 16px; }
  .lx-vshowcase__mute-btn--hidden { display: none !important; }
  .lx-vshowcase__mute-btn:hover { background: rgba(0,0,0,0.75); }
  .lx-vshowcase__card-title {
    position: absolute; bottom: 16px; left: 16px; right: 16px;
    color: white; font-size: 13px; font-weight: 600; z-index: 5;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
  }
  .lx-vshowcase__btn {
    flex-shrink: 0;
    width: 50px; height: 50px; border-radius: 50%;
    background: {{ section.settings.accent_color }};
    border: none; color: white;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; z-index: 10;
    transition: all 0.3s ease;
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    position: absolute; top: 50%; transform: translateY(-50%);
  }
  .lx-vshowcase__btn--prev { left: 10px; }
  .lx-vshowcase__btn--next { right: 10px; }
  .lx-vshowcase__btn:hover { transform: translateY(-50%) scale(1.1); }
  .lx-vshowcase__btn.swiper-button-disabled { opacity: 0.35; cursor: not-allowed; transform: translateY(-50%); }
  .lx-vshowcase__btn svg { width: 22px; height: 22px; }
  @media screen and (max-width: 768px) {
    .lx-vshowcase__btn { width: 38px; height: 38px; }
    .lx-vshowcase__btn svg { width: 17px; height: 17px; }
    .lx-vshowcase__btn--prev { left: 4px; }
    .lx-vshowcase__btn--next { right: 4px; }
  }
  .lx-vshowcase__pagination { bottom: 16px !important; }
  .lx-vshowcase__pagination .swiper-pagination-bullet {
    width: 8px; height: 8px;
    background: {{ section.settings.text_color }}; opacity: 0.35;
    border-radius: 50%; transition: all 0.3s;
  }
  .lx-vshowcase__pagination .swiper-pagination-bullet-active {
    opacity: 1; width: 24px; border-radius: 4px;
    background: {{ section.settings.accent_color }};
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var sectionId = '{{ section.id }}';
  var swiper = new Swiper('#lxvs-swiper-' + sectionId, {
    effect: 'coverflow',
    grabCursor: true,
    centeredSlides: true,
    slidesPerView: 'auto',
    loop: {{ section.settings.loop | json }},
    coverflowEffect: {
      rotate: 0,
      stretch: 30,
      depth: 180,
      modifier: 1,
      slideShadows: false,
    },
    pagination: {
      el: '#lxvs-pag-' + sectionId,
      clickable: true,
    },
    navigation: {
      prevEl: '#lxvs-prev-' + sectionId,
      nextEl: '#lxvs-next-' + sectionId,
    },
    autoplay: {{ section.settings.autoplay | json }} ? {
      delay: {{ section.settings.autoplay_delay }},
      disableOnInteraction: false,
    } : false,
    on: {
      slideChange: function () {
        document.querySelectorAll('#lxvs-swiper-' + sectionId + ' .lx-vshowcase__card').forEach(function(card) {
          pauseCard(card);
        });
      }
    }
  });

  function pauseCard(card) {
    var video = card.querySelector('.lx-vshowcase__video-el');
    var iframe = card.querySelector('.lx-vshowcase__iframe');
    var thumb = card.querySelector('.lx-vshowcase__thumb');
    var videoWrap = card.querySelector('.lx-vshowcase__video-wrap');
    var playBtn = card.querySelector('.lx-vshowcase__play-btn');
    var muteBtn = card.querySelector('.lx-vshowcase__mute-btn');
    if (video) video.pause();
    if (iframe) { var s = iframe.src; iframe.src = ''; iframe.src = s; }
    if (videoWrap) videoWrap.style.display = 'none';
    if (thumb) thumb.style.display = '';
    if (playBtn) playBtn.classList.remove('is-hidden');
    if (muteBtn) muteBtn.classList.add('lx-vshowcase__mute-btn--hidden');
  }

  document.querySelectorAll('#lxvs-swiper-' + sectionId + ' .lx-vshowcase__play-btn').forEach(function(btn) {
    btn.addEventListener('click', function () {
      var card = btn.closest('.lx-vshowcase__card');
      var thumb = card.querySelector('.lx-vshowcase__thumb');
      var videoWrap = card.querySelector('.lx-vshowcase__video-wrap');
      var video = card.querySelector('.lx-vshowcase__video-el');
      var muteBtn = card.querySelector('.lx-vshowcase__mute-btn');
      thumb.style.display = 'none';
      videoWrap.style.display = '';
      btn.classList.add('is-hidden');
      if (muteBtn) muteBtn.classList.remove('lx-vshowcase__mute-btn--hidden');
      if (video) { video.play(); video.muted = true; }
    });
  });

  document.querySelectorAll('#lxvs-swiper-' + sectionId + ' .lx-vshowcase__mute-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var card = btn.closest('.lx-vshowcase__card');
      var video = card.querySelector('.lx-vshowcase__video-el');
      var iconSound = btn.querySelector('.lx-icon-sound');
      var iconMuted = btn.querySelector('.lx-icon-muted');
      if (video) {
        video.muted = !video.muted;
        iconSound.style.display = video.muted ? '' : 'none';
        iconMuted.style.display = video.muted ? 'none' : '';
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "Video Showcase Slider",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Badge",
      "default": "Customer Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch Real Results"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0d0d0d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Button Color",
      "default": "#9b1d1d"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop Slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "label": "Autoplay Speed",
      "default": 4000
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Customer Video"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail Image"
        },
        {
          "type": "select",
          "id": "video_type",
          "label": "Video Type",
          "options": [
            { "value": "native", "label": "Direct URL (MP4)" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "vimeo", "label": "Vimeo" }
          ],
          "default": "youtube"
        },
        {
          "type": "text",
          "id": "video_id",
          "label": "YouTube / Vimeo Video ID",
          "info": "For YouTube: the part after ?v= in the URL. For Vimeo: the number in the URL."
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Direct MP4 Video URL",
          "info": "Only used when Video Type is 'Direct URL'"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Showcase Slider",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
