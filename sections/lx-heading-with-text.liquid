{% comment %}
---------------------------------------------------------
  SECTION: LX Heading With Text
  Fully Customizable Heading + Richtext + Gradient BG
---------------------------------------------------------
{% endcomment %}
<style>
#section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
}
#lx-heading-{{ section.id }} .lx-heading-container {
    margin: 0 auto;
    text-align: center;
    padding-left: 20px;
    padding-right: 20px;
}

#lx-heading-{{ section.id }} .lx-heading-title {
    font-weight: 700;
    margin-bottom: 10px;
}
h2.lx-heading-title {
    margin: 0;
    font-weight: 500;
}

.lx-heading-text {
    max-width: 600px;
}

.lx-heading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
}
.lx-heading-text {
    margin-top: 20px;
}

.lx-heading-text p {
    margin: 0;
}
.lx-heading-text p {
    line-height: 135%;
    letter-spacing: 0;
}
#lx-heading-{{ section.id }} .lx-heading-text {
    max-width: 750px;
    margin: 0 auto;
    line-height: 1.6;
}
.lx-heading-container {
    margin: 0 auto;
    text-align: center;
}
@media (max-width: 768px) {
#lx-heading-{{ section.id }} .lx-heading-title {
    font-size: {{ section.settings.heading_size_mobile }}px !important;
}
#lx-heading-{{ section.id }} .lx-heading-text {
    font-size: {{ section.settings.text_size_mobile }}px !important;
}
}
@media (max-width: 750px) {
  #section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px !important;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px !important;
  }
  h2.lx-heading-title {
        font-size: 24px!important;
    }

    h2.lx-heading-title {
        line-height: 100%;
    }

    .lx-heading-text p br {
        display: none;
    }
}

@keyframes gradientShift {
  0% {
    background-position: 0%;
  }
  100% {
    background-position: 200%;
  }
}
</style>
<div
  id="section-{{ section.id }}"
  class="lx-heading-wrapper "
  style="
    background: {{ section.settings.bg_gradient }};
    background-size: 200% 100%;
    animation: gradientShift 3s linear infinite;
  "
>
  <div class="lx-heading-container page-width">
    {%- if section.settings.heading != blank -%}
      <h2
        class="lx-heading-title"
        style="
          color: {{ section.settings.heading_color }};
          font-size: {{ section.settings.heading_size }}px;
        "
      >
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div
        class="lx-heading-text"
        style="
          color: {{ section.settings.text_color }};
          font-size: {{ section.settings.text_size }}px;
        "
      >
        {{ section.settings.text }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Heading With Text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size (Desktop)",
      "min": 18,
      "step": 1,
      "max": 60,
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Font Size (Mobile)",
      "min": 14,
      "step": 1,
      "max": 40,
      "default": 24
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },

    {
      "type": "richtext",
      "id": "text",
      "label": "Description Text"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size (Desktop)",
      "min": 12,
      "step": 1,
      "max": 30,
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text Size (Mobile)",
      "min": 10,
      "step": 1,
      "max": 26,
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "default": "linear-gradient(90deg, #0d4f2b 0%, #1a7a45 100%)",
      "info": "Paste any CSS gradient example: linear-gradient(90deg, #123, #456)"
    },
    {
        "type": "range",
        "id": "desktop_padding_top",
        "min": 0,
        "max": 150,
        "step": 5,
        "label": "Desktop padding top",
        "default": 50
    },
    {
        "type": "range",
        "id": "desktop_padding_bottom",
        "min": 0,
        "max": 150,
        "step": 5,
        "label": "Desktop padding bottom",
        "default": 50
    },
    {
        "type": "range",
        "id": "mobile_padding_top",
        "min": 0,
        "max": 150,
        "step": 5,
        "label": "Mobile padding top",
        "default": 30
    },
    {
        "type": "range",
        "id": "mobile_padding_bottom",
        "min": 0,
        "max": 150,
        "step": 5,
        "label": "Mobile padding bottom",
        "default": 30
    }
  ],
  "presets": [
    {
      "name": "Heading With Text"
    }
  ]
}
{% endschema %}
