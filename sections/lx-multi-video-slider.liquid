{% comment %}
  Multi Video Slider - Using Template Slider Manager
{% endcomment %}

{{ 'lx-multi-video-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .video-slider-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-bg-color: {{ section.settings.bg_color }};
    --heading-size: {{ section.settings.heading_size }}px;
    --heading-color: {{ section.settings.heading_color }};
    --text-color: {{ section.settings.text_color }};
    --card-border-radius: {{ section.settings.card_border_radius }}px;
    --card-height-desktop: {{ section.settings.card_height_desktop }}px;
    --card-height-mobile: {{ section.settings.card_height_mobile }}px;
    --play-btn-size: {{ section.settings.play_btn_size }}px;
    --play-btn-bg: {{ section.settings.play_btn_bg }};
    --play-btn-icon-color: {{ section.settings.play_btn_icon_color }};
    --arrow-bg: {{ section.settings.arrow_bg }};
    --arrow-color: {{ section.settings.arrow_color }};
    --dot-color: {{ section.settings.dot_color }};
    --dot-active-color: {{ section.settings.dot_active_color }};
    --scrollbar-track: {{ section.settings.scrollbar_track }};
    --scrollbar-thumb: {{ section.settings.scrollbar_thumb }};
    --progress-track: {{ section.settings.progress_track }};
    --progress-fill: {{ section.settings.progress_fill }};
  }
{%- endstyle -%}

<section 
  class="video-slider-section video-slider-section-{{ section.id }} color-{{ section.settings.color_scheme }} isolate gradient"
  data-section-id="{{ section.id }}"
>
  <div class="video-slider-container">

    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="video-slider-header page-width" style="text-align: {{ section.settings.heading_align }};">
        {%- if section.settings.heading != blank -%}
          <h2 class="video-slider-heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="video-slider-text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="slider-wrapper relative-container">
      <swiper-container 
        init="false" 
        class="js-swiper-template video-swiper-{{ section.id }}"
        data-swiper-config='{
          "autoplay": {{ section.settings.enable_autoplay | default: false }},
          "autoplayInterval": {{ section.settings.autoplay_interval | times: 1000 | default: 3000 }},
          "mobileSlides": {{ section.settings.mobile_slides | default: 1.2 }},
          "mobileSpacing": {{ section.settings.mobile_spacing | default: 16 }},
          "desktopSlides": {{ section.settings.desktop_slides | default: 3 }},
          "desktopSpacing": {{ section.settings.desktop_spacing | default: 24 }},
          "loop": {{ section.settings.enable_loop | default: false }},
          "centeredSlides": true
        }'
      >
        {%- for block in section.blocks -%}
          <swiper-slide {{ block.shopify_attributes }}>
            <div class="video-card" data-block-id="{{ block.id }}">
              {%- comment -%} Thumbnail {%- endcomment -%}
              <div class="video-card__thumbnail" data-thumbnail="{{ block.id }}">
                {%- if block.settings.thumbnail != blank -%}
                  <img 
                    src="{{ block.settings.thumbnail | image_url: width: 600 }}"
                    srcset="{{ block.settings.thumbnail | image_url: width: 300 }} 300w,
                            {{ block.settings.thumbnail | image_url: width: 450 }} 450w,
                            {{ block.settings.thumbnail | image_url: width: 600 }} 600w"
                    sizes="(max-width: 749px) 90vw, 400px"
                    alt="{{ block.settings.thumbnail.alt | default: 'Video thumbnail' | escape }}"
                    class="video-card__thumbnail-img"
                    loading="lazy"
                    width="{{ block.settings.thumbnail.width }}"
                    height="{{ block.settings.thumbnail.height }}"
                  >
                {%- elsif block.settings.video_url != blank and block.settings.video_url.preview_image != blank -%}
                  <img 
                    src="{{ block.settings.video_url.preview_image | image_url: width: 600 }}"
                    alt="Video thumbnail"
                    class="video-card__thumbnail-img"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="video-card__placeholder">
                    {{ 'image' | placeholder_svg_tag: 'video-card__placeholder-svg' }}
                  </div>
                {%- endif -%}

                {%- comment -%} Play Button {%- endcomment -%}
                {%- if section.settings.show_play_button -%}
                  <button 
                    type="button" 
                    class="video-card__play-btn"
                    aria-label="Play video"
                    data-play-btn="{{ block.id }}"
                  >
                    <svg width="54" height="54" viewBox="0 0 54 54" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <mask id="mask-{{ block.id }}" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="0" y="0" width="54" height="54">
                        <path d="M26.8333 52.6667C41.1011 52.6667 52.6667 41.1011 52.6667 26.8333C52.6667 12.5656 41.1011 1 26.8333 1C12.5656 1 1 12.5656 1 26.8333C1 41.1011 12.5656 52.6667 26.8333 52.6667Z" fill="white" stroke="white" stroke-width="2" stroke-linejoin="round"/>
                        <path d="M21.666 26.8334V17.8848L29.416 22.3591L37.166 26.8334L29.416 31.3078L21.666 35.7821V26.8334Z" fill="black" stroke="black" stroke-width="2" stroke-linejoin="round"/>
                      </mask>
                      <g mask="url(#mask-{{ block.id }})">
                        <path d="M-4.16602 -4.16797H57.834V57.832H-4.16602V-4.16797Z" fill="currentColor"/>
                      </g>
                    </svg>
                  </button>
                {%- endif -%}
              </div>

              {%- comment -%} Video Element {%- endcomment -%}
              {%- if block.settings.video_url != blank -%}
                <div class="video-card__video" data-video-wrapper="{{ block.id }}">
                  {{ block.settings.video_url | video_tag: 
                    autoplay: false, 
                    controls: false, 
                    muted: block.settings.video_muted, 
                    loop: block.settings.video_loop,
                    class: 'video-card__video-element',
                    data-video-id: block.id
                  }}
                  <div class="video-card__controls">
                    <button 
                      type="button" 
                      class="video-btn video-btn--mute"
                      data-mute-toggle="{{ block.id }}"
                      aria-label="Mute / Unmute"
                    >
                      <span class="icon-unmuted"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M2 16.0001H5.88889L11.1834 20.3319C11.2727 20.405 11.3846 20.4449 11.5 20.4449C11.7761 20.4449 12 20.2211 12 19.9449V4.05519C12 3.93977 11.9601 3.8279 11.887 3.73857C11.7121 3.52485 11.3971 3.49335 11.1834 3.66821L5.88889 8.00007H2C1.44772 8.00007 1 8.44778 1 9.00007V15.0001C1 15.5524 1.44772 16.0001 2 16.0001ZM23 12C23 15.292 21.5539 18.2463 19.2622 20.2622L17.8445 18.8444C19.7758 17.1937 21 14.7398 21 12C21 9.26016 19.7758 6.80629 17.8445 5.15557L19.2622 3.73779C21.5539 5.75368 23 8.70795 23 12ZM18 12C18 10.0883 17.106 8.38548 15.7133 7.28673L14.2842 8.71584C15.3213 9.43855 16 10.64 16 12C16 13.36 15.3213 14.5614 14.2842 15.2841L15.7133 16.7132C17.106 15.6145 18 13.9116 18 12Z"></path></svg></span>
                      <span class="icon-muted"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M5.88889 16.0001H2C1.44772 16.0001 1 15.5524 1 15.0001V9.00007C1 8.44778 1.44772 8.00007 2 8.00007H5.88889L11.1834 3.66821C11.3971 3.49335 11.7121 3.52485 11.887 3.73857C11.9601 3.8279 12 3.93977 12 4.05519V19.9449C12 20.2211 11.7761 20.4449 11.5 20.4449C11.3846 20.4449 11.2727 20.405 11.1834 20.3319L5.88889 16.0001ZM20.4142 12.0001L23.9497 15.5356L22.5355 16.9498L19 13.4143L15.4645 16.9498L14.0503 15.5356L17.5858 12.0001L14.0503 8.46454L15.4645 7.05032L19 10.5859L22.5355 7.05032L23.9497 8.46454L20.4142 12.0001Z"></path></svg></span>
                    </button>
                    <button 
                      type="button" 
                      class="video-btn video-btn--play"
                      data-play-toggle="{{ block.id }}"
                      aria-label="Play / Pause"
                    >
                      <span class="icon-play"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22ZM12 20C16.4183 20 20 16.4183 20 12C20 7.58172 16.4183 4 12 4C7.58172 4 4 7.58172 4 12C4 16.4183 7.58172 20 12 20ZM10.6219 8.41459L15.5008 11.6672C15.6846 11.7897 15.7343 12.0381 15.6117 12.2219C15.5824 12.2658 15.5447 12.3035 15.5008 12.3328L10.6219 15.5854C10.4381 15.708 10.1897 15.6583 10.0672 15.4745C10.0234 15.4088 10 15.3316 10 15.2526V8.74741C10 8.52649 10.1791 8.34741 10.4 8.34741C10.479 8.34741 10.5562 8.37078 10.6219 8.41459Z"></path></svg></span>
                      <span class="icon-pause"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22ZM12 20C16.4183 20 20 16.4183 20 12C20 7.58172 16.4183 4 12 4C7.58172 4 4 7.58172 4 12C4 16.4183 7.58172 20 12 20ZM9 9H11V15H9V9ZM13 9H15V15H13V9Z"></path></svg></span>
                    </button>
                  </div>
                </div>
              {%- endif -%}

              {%- comment -%} Video Title {%- endcomment -%}
              {%- if block.settings.video_title != blank and section.settings.show_video_title -%}
                <div class="video-card__title">
                  {{ block.settings.video_title }}
                </div>
              {%- endif -%}
            </div>
          </swiper-slide>
        {%- endfor -%}
      </swiper-container>

      {%- comment -%} Custom Controls {%- endcomment -%}
      <div class="swiper-custom-controls">
        <div class="swiper-custom-prev swiper-custom-arrow 
          {% unless section.settings.mobile_arrows %}hide-on-mobile{% endunless %} 
          {% unless section.settings.desktop_arrows %}hide-on-desktop{% endunless %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </div>
        
        <div class="swiper-custom-pagination 
          {% unless section.settings.mobile_dots %}hide-on-mobile{% endunless %} 
          {% unless section.settings.desktop_dots %}hide-on-desktop{% endunless %}">
        </div>

        <div class="swiper-custom-next swiper-custom-arrow 
          {% unless section.settings.mobile_arrows %}hide-on-mobile{% endunless %} 
          {% unless section.settings.desktop_arrows %}hide-on-desktop{% endunless %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
      </div>

      <div class="swiper-custom-scrollbar
        {% unless section.settings.mobile_scrollbar %}hide-on-mobile{% endunless %} 
        {% unless section.settings.desktop_scrollbar %}hide-on-desktop{% endunless %}">
      </div>

      <div class="swiper-progress-track
        {% unless section.settings.mobile_progress_bar %}hide-on-mobile{% endunless %} 
        {% unless section.settings.desktop_progress_bar %}hide-on-desktop{% endunless %}">
        <div class="swiper-progress-fill"></div>
      </div>
    </div>

  </div>
</section>

<script>
(function () {
  const sectionId = '{{ section.id }}';
  const section = document.querySelector('.video-slider-section-' + sectionId);
  if (!section) return;

  function pauseAllVideos() {
    section.querySelectorAll('.video-card.is-playing').forEach(card => {
      const video = card.querySelector('video');
      const thumbnail = card.querySelector('.video-card__thumbnail');
      const wrapper = card.querySelector('.video-card__video');

      card.classList.remove('is-playing');

      if (thumbnail) thumbnail.classList.remove('is-hidden');
      if (wrapper) wrapper.classList.remove('is-visible');

      if (video) video.pause();
    });
  }

  function initVideoCards() {
    section.querySelectorAll('.video-card').forEach(card => {
      const blockId = card.dataset.blockId;
      const video = card.querySelector('video');
      const thumbnail = card.querySelector('[data-thumbnail="' + blockId + '"]');
      const wrapper = card.querySelector('[data-video-wrapper="' + blockId + '"]');

      const playBtnOverlay = card.querySelector('[data-play-btn="' + blockId + '"]');
      const playBtnControl = card.querySelector('[data-play-toggle="' + blockId + '"]');
      const muteBtn = card.querySelector('[data-mute-toggle="' + blockId + '"]');

      if (!video || card.dataset.init === 'true') return;
      card.dataset.init = 'true';

      /* ▶ PLAY */
      function playVideo() {
        pauseAllVideos();

        card.classList.add('is-playing');
        if (thumbnail) thumbnail.classList.add('is-hidden');
        if (wrapper) wrapper.classList.add('is-visible');

        video.play().catch(() => {});
      }

      /* ⏸ PAUSE */
      function pauseVideo() {
        card.classList.remove('is-playing');
        if (thumbnail) thumbnail.classList.remove('is-hidden');
        if (wrapper) wrapper.classList.remove('is-visible');
        video.pause();
      }

      /* ▶ / ⏸ PLAY TOGGLE (BOTH BUTTONS) */
      [playBtnOverlay, playBtnControl].forEach(btn => {
        if (!btn) return;
        btn.addEventListener('click', () => {
          card.classList.contains('is-playing')
            ? pauseVideo()
            : playVideo();
        });
      });

      /* 🔇 MUTE TOGGLE */
      if (muteBtn) {
        card.classList.toggle('is-muted', video.muted);
        muteBtn.addEventListener('click', () => {
          video.muted = !video.muted;
          card.classList.toggle('is-muted', video.muted);
        });
      }

      /* VIDEO END */
      video.addEventListener('ended', () => {
        if (!video.loop) pauseVideo();
      });
    });
  }

  /* SLIDE CHANGE = PAUSE */
  const swiperEl = section.querySelector('swiper-container');
  if (swiperEl) {
    swiperEl.addEventListener('swiperslidechange', pauseAllVideos);
  }

  /* INIT */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoCards);
  } else {
    initVideoCards();
  }

  /* SHOPIFY EDITOR */
  document.addEventListener('shopify:section:load', e => {
    if (e.detail.sectionId === sectionId) initVideoCards();
  });
})();
</script>



{% schema %}
{
  "name": "Multi Video Slider",
  "tag": "section",
  "class": "video-slider-section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "🎨 Section Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "📝 Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "@nuchu"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description Text"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "🎬 Video Card Settings"
    },
    {
      "type": "range",
      "id": "card_height_desktop",
      "min": 200,
      "max": 700,
      "step": 20,
      "unit": "px",
      "label": "Card Height (Desktop)",
      "default": 420
    },
    {
      "type": "range",
      "id": "card_height_mobile",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "label": "Card Height (Mobile)",
      "default": 360
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_video_title",
      "label": "Show Video Title",
      "default": false
    },
    {
      "type": "header",
      "content": "▶️ Play Button"
    },
    {
      "type": "checkbox",
      "id": "show_play_button",
      "label": "Show Play Button",
      "default": true
    },
    {
      "type": "range",
      "id": "play_btn_size",
      "min": 30,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Play Button Size",
      "default": 54
    },
    {
      "type": "color",
      "id": "play_btn_bg",
      "label": "Play Button Background",
      "default": "rgba(232, 232, 232, 0.7)"
    },
    {
      "type": "color",
      "id": "play_btn_icon_color",
      "label": "Play Button Icon Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "⚙️ Slider Configuration"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Interval",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Enable Loop",
      "default": false
    },
    {
      "type": "header",
      "content": "💻 Desktop Settings"
    },
    {
      "type": "range",
      "id": "desktop_slides",
      "min": 1,
      "max": 6,
      "step": 0.1,
      "label": "Slides per View",
      "default": 3
    },
    {
      "type": "range",
      "id": "desktop_spacing",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Spacing",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "desktop_arrows",
      "label": "Show Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "desktop_dots",
      "label": "Show Dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "desktop_scrollbar",
      "label": "Show Draggable Scrollbar",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "desktop_progress_bar",
      "label": "Show Visual Progress Bar",
      "default": true
    },
    {
      "type": "header",
      "content": "📱 Mobile Settings"
    },
    {
      "type": "range",
      "id": "mobile_slides",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "label": "Slides per View",
      "default": 1.2
    },
    {
      "type": "range",
      "id": "mobile_spacing",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Spacing",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "mobile_arrows",
      "label": "Show Arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mobile_dots",
      "label": "Show Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_scrollbar",
      "label": "Show Draggable Scrollbar",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mobile_progress_bar",
      "label": "Show Visual Progress Bar",
      "default": true
    },
    {
      "type": "header",
      "content": "🎨 Controls Styling"
    },
    {
      "type": "color",
      "id": "arrow_bg",
      "label": "Arrow Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot Color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Dot Active Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "scrollbar_track",
      "label": "Scrollbar Track Color",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "scrollbar_thumb",
      "label": "Scrollbar Thumb Color",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "progress_track",
      "label": "Progress Bar Track",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "progress_fill",
      "label": "Progress Bar Fill",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "video_block",
      "name": "Video Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail Image",
          "info": "Recommended: 600x800px or 9:16 aspect ratio"
        },
        {
          "type": "video",
          "id": "video_url",
          "label": "Upload Video"
        },
        {
          "type": "text",
          "id": "video_title",
          "label": "Video Title (Optional)"
        },
        {
          "type": "checkbox",
          "id": "video_loop",
          "label": "Loop Video",
          "default": true
        },
        {
