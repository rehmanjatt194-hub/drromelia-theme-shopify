{{ 'lx-multi-videos.css' | asset_url | stylesheet_tag }}

<style>
#section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
}
@media (max-width: 750px) {
    #section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px !important;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px !important;
    }
}
</style>

<div id="section-{{ section.id }}" class="lx-multi-videos--row color-{{ section.settings.color_scheme }} isolate gradient {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  style="
  --desktop-video-card:{{ section.settings.desktop__show }};
  --tablet-video-card:{{ section.settings.tablet__show }};
  --mobile-video-card:{{ section.settings.mobile__show }};"
>
  <div class="page-width">
    <div class="lx-multi-video-inner-row">
        <div class="lx-multi-video-header">
            {% if section.settings.heading %}
            <h2
                style="
                    font-size: {{ section.settings.heading_size }}px;
                    text-align: {{ section.settings.heading_align }};
                "
            >
                {{ section.settings.heading }}
            </h2>
            {% endif %}

            {% if section.settings.text %}
            <div
                style="
                    font-size: {{ section.settings.text_size }}px;
                    text-align: {{ section.settings.heading_align }};
                "
                class="lx-multi-video-header--text"
            >
                {{ section.settings.text }}
            </div>
            {% endif %}
        </div>
        <div class="lx-multi-video-wrapper" style="--heading-size:{{ section.settings.card_heading_size }}px;--text-size:{{ section.settings.card_text_size }}px;---card-text-color:{{ section.settings.card_text_color }};">
           {% for block in section.blocks %}
                <div class="video-card--wr lx-multi-video-item {% if section.settings.video_autoplay %}video--playing{% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                    <div class="lx-multi-video-item---video">
                        {% if block.settings.thumbnail %}
                            {% render 'lx-liquid-image' image: block.settings.thumbnail %}
                        {% endif %}

                        {% if block.settings.video_url %}
                            {{ block.settings.video_url | video_tag:
                                autoplay: section.settings.video_autoplay,
                                controls: section.settings.video_controls,
                                loop: section.settings.video_loop
                            }}
                        {% endif %}

                        {% if block.settings.icon %}
                            <span class="play___icon___wrapper">
                                {% render 'lx-liquid-image' image: block.settings.icon %}
                            </span>
                        {% endif %}
                    </div>
                    <div class="multi-video-item-inner">
                        {% if block.settings.card_heading %}
                            <h3>
                                {{ block.settings.card_heading }}
                            </h3>
                        {% endif %}

                        {% if block.settings.card_text %}
                            <div class="multi-video-item---text">
                                {{ block.settings.card_text }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  
  const videoCards = document.querySelectorAll(".video-card");

  videoCards.forEach((card) => {
    const playBtn = card.querySelector(".play___icon___wrapper");
    const video = card.querySelector("video");
    const thumbnail = card.querySelector(".lx-liquid-image");

    if (playBtn && video) {
      playBtn.addEventListener("click", function () {
        card.classList.add("video--playing");
        video.muted = false;
        video.play();
      });
    }
  });
});
</script>


{% schema %}
 {
  "name": "Content with videos",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Text Content Settings"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sleep Better Everywhere" },
    { "type": "richtext", "id": "text", "label": "Text"},

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 12,
      "max": 100,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size",
      "min": 10,
      "max": 60,
      "step": 1,
      "default": 16
    },

    {
      "type": "select",
      "id": "heading_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },

    {
      "type": "header",
      "content": "Video Settings"
    },
    { "type": "checkbox", "id": "video_autoplay", "label": "Autoplay", "default": false },
    { "type": "checkbox", "id": "video_controls", "label": "Show Controls", "default": true },
    { "type": "checkbox", "id": "video_loop", "label": "Loop", "default": true },

    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
        "type": "range",
        "id": "desktop_padding_top",
        "min": 0,
        "max": 150,
        "step": 5,
        "label": "Desktop Padding Top",
        "default": 50
    },
    {
        "type": "range",
        "id": "desktop_padding_bottom",
        "min": 0,
        "max": 150,
        "step": 5,
        "label": "Desktop Padding Bottom",
        "default": 50
    },
    {
        "type": "range",
        "id": "mobile_padding_top",
        "min": 0,
        "max": 150,
        "step": 5,
        "label": "Mobile Padding Top",
        "default": 30
    },
    {
        "type": "range",
        "id": "mobile_padding_bottom",
        "min": 0,
        "max": 150,
        "step": 5,
        "label": "Mobile Padding Bottom",
        "default": 30
    },
    {
        "type": "header",
        "content": "Video Card Settings"
    },
    {
        "type": "range",
        "id": "desktop__show",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Desktop video column",
        "default": 3
    },
    {
        "type": "range",
        "id": "tablet__show",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "tablet video column",
        "default": 2
    },
    {
        "type": "range",
        "id": "Mobile__show",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Mobile video column",
        "default": 1
    },
    {
        "type": "range",
        "id": "card_heading_size",
        "label": "Card Heading Size",
        "min": 10,
        "max": 50,
        "step": 1,
        "default": 18
    },
    {
        "type": "range",
        "id": "card_text_size",
        "label": "Card Text Size",
        "min": 10,
        "max": 40,
        "step": 1,
        "default": 14
    }
  ],

  "blocks": [
    {
      "type": "video_block",
      "name": "Video Item",
      "settings": [
        {
          "type": "header",
          "content": "Card Media"
        },

        { "type": "image_picker", "id": "thumbnail", "label": "Thumbnail" },
        { "type": "video", "id": "video_url", "label": "Upload Video" },
        { "type": "image_picker", "id": "icon", "label": "Play Icon" },

        { "type": "text", "id": "card_heading", "label": "Card Heading", "default": "Bedroom" },
        { "type": "richtext", "id": "card_text", "label": "Card Text" },

        
      ]
    }
  ],

  "max_blocks": 20,
  "presets": [
    { "name": "Content with videos" }
  ]
}

{% endschema %}