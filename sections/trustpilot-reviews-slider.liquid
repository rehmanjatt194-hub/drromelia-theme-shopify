{{ 'trustpilot-reviews-slider.css' | asset_url | stylesheet_tag }}

<div class="template-slider-section color-{{ section.settings.color_scheme }} isolate gradient trustpilot-reviews-section layout-{{ section.settings.layout_style }}" data-block-id="{{ section.id }}">
  
  {% if section.settings.layout_style == 'header-top' %}
    <!-- Top Header Layout -->
    <div class="trustpilot-top-header">
      {%- if section.settings.section_title != blank -%}
        <h2 class="trustpilot-title">{{ section.settings.section_title }}</h2>
      {%- endif -%}
      {% if section.settings.sb_text != blank %}
        <div class="trustpilot-subtitle">
          <div class="trustpilot-subtitle--txt">
            {{ section.settings.sb_text }}
          </div>
          {% if section.settings.tr_pilot != blank %}
            <div class="trustpilot-badge">
              {% render 'lx-liquid-image' image: section.settings.tr_pilot %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="page-width page-width--trust--pilot {% if section.settings.full_width %}full_width_active{% endif %} {% if section.settings.acitve-shades %}right-left-shades{% endif %}">

    
    {% if section.settings.layout_style == 'side-card' %}
      <!-- Left Summary Card -->
      <div class="trustpilot-summary-card">
        <h2 class="trustpilot-brand-name">
          {{ section.settings.brand_name }}
        </h2>
        
        <div class="trustpilot-stars-display">
          {% for i in (1..5) %}
            <span class="tp-star {% if i <= section.settings.star_rating %}tp-star-filled{% else %}tp-star-empty{% endif %}">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
              </svg>
            </span>
          {% endfor %}
        </div>
        
        <p class="trustpilot-rating-text">
          <strong>{{ section.settings.rating_score }} stars out of 5</strong> |
          <br>Based on {{ section.settings.review_count }} reviews
        </p>
        
        <div class="trustpilot-logo">
          <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="88" height="22" viewBox="0 0 88 22" fill="none">
            <rect width="88" height="22" fill="url(#pattern0_365_1307)"/>
            <defs>
            <pattern id="pattern0_365_1307" patternContentUnits="objectBoundingBox" width="1" height="1">
            <use xlink:href="#image0_365_1307" transform="matrix(0.00220264 0 0 0.00881057 0 0.0110132)"/>
            </pattern>
            <image id="image0_365_1307" width="454" height="111" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
            </defs>
        </svg>
        </div>
      </div>
    {% endif %}

    <div class="slider-wrapper relative-container trustpilot-slider-wrapper">
      <div class="swiper-custom-header">
        <div class="swiper-custom-heading">
          {%- if section.settings.block_heading != blank -%}
            {{ section.settings.block_heading }}
          {%- endif -%}
        </div>
      </div>

      <swiper-container
        init="false" 
        class="js-swiper-template"
        data-swiper-config='{
          "autoplay": {{ section.settings.enable_autoplay | default: false }},
          "autoplayInterval": {{ section.settings.autoplay_interval | times: 1000 | default: 5000 }},
          "mobileSlides": {{ section.settings.mobile_slides | default: 1 }},
          "mobileSpacing": {{ section.settings.mobile_spacing | default: 16 }},
          "desktopSlides": {{ section.settings.desktop_slides | default: 4 }},
          "desktopSpacing": {{ section.settings.desktop_spacing | default: 20 }}
        }'
      >
        {% for block in section.blocks %}
          <swiper-slide>
            <div class="review-card card-style-{{ section.settings.card_style }}" {{ block.shopify_attributes }}>
              
              {% if section.settings.card_style == 'style-1' %}
                <!-- Style 1: Header with name & date, then stars, then text -->
                <div class="review-stars">
                  {% assign stars = block.settings.stars | default: 5 %}
                  {% for i in (1..5) %}
                    <span class="review-star {% if i <= stars %}filled{% endif %}">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                      </svg>
                    </span>
                  {% endfor %}
                </div>
                
                <p class="review-text">{{ block.settings.review_text }}</p>
              
                <div class="review-header">
                  <span class="reviewer-name">{{ block.settings.reviewer_name }}</span>
                  <span class="review-date">{{ block.settings.review_date }}</span>
                </div>

              {% else %}
                <div class="review-stars">
                  {% assign stars = block.settings.stars | default: 5 %}
                  {% for i in (1..5) %}
                    <span class="review-star {% if i <= stars %}filled{% endif %}">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                      </svg>
                    </span>
                  {% endfor %}
                </div>
                
                <p class="review-text">{{ block.settings.review_text }}</p>
                
                <span class="reviewer-name">{{ block.settings.reviewer_name }}</span>
              {% endif %}
              
            </div>
          </swiper-slide>
        {% endfor %}
      </swiper-container>

      <div class="swiper-custom-controls">
        <div class="swiper-custom-prev swiper-custom-arrow 
          {% unless section.settings.mobile_arrows %}hide-on-mobile{% endunless %} 
          {% unless section.settings.desktop_arrows %}hide-on-desktop{% endunless %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </div>
        
        <div class="swiper-custom-pagination 
          {% unless section.settings.mobile_dots %}hide-on-mobile{% endunless %} 
          {% unless section.settings.desktop_dots %}hide-on-desktop{% endunless %}">
        </div>

        <div class="swiper-custom-next swiper-custom-arrow 
          {% unless section.settings.mobile_arrows %}hide-on-mobile{% endunless %} 
          {% unless section.settings.desktop_arrows %}hide-on-desktop{% endunless %}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </div>
      </div>

      <div class="swiper-custom-scrollbar
        {% unless section.settings.mobile_scrollbar %}hide-on-mobile{% endunless %} 
        {% unless section.settings.desktop_scrollbar %}hide-on-desktop{% endunless %}">
      </div>

      <div class="swiper-progress-track
        {% unless section.settings.mobile_progress_bar %}hide-on-mobile{% endunless %} 
        {% unless section.settings.desktop_progress_bar %}hide-on-desktop{% endunless %}">
        <div class="swiper-progress-fill"></div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('shopify:block:select', (e) => {
    const container = document.querySelector(`.template-slider-section[data-block-id="${e.detail.blockId}"] swiper-container`);
    if (container) templateSliderManager.initSingleSlider(container);
  });
</script>

{% schema %}
{
  "name": "Trustpilot Reviews",
  "tag": "section",
  "class": "trustpilot-section",
  "settings": [
    {
      "type": "header",
      "content": "Color Scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "🎨 Layout Options"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout Style",
      "options": [
        { "value": "side-card", "label": "Side Card (Summary Left)" },
        { "value": "header-top", "label": "Header Top (Centered)" }
      ],
      "default": "side-card"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Review Card Style",
      "options": [
        { "value": "style-1", "label": "Style 1: Name & Date on Top" },
        { "value": "style-2", "label": "Style 2: Name on Bottom" }
      ],
      "default": "style-1"
    },
    {
      "type": "header",
      "content": "📝 Header Top Settings"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "What Customers Think About Us"
    },
    {
      "type": "url",
      "id": "trustpilot_link",
      "label": "Trustpilot Profile Link"
    },
    {
      "type": "header",
      "content": "🏷️ Side Card Settings"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Shilajit"
    },
    {
      "type": "range",
      "id": "star_rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Star Rating Display",
      "default": 5
    },
    {
      "type": "header",
      "content": "⭐ Rating Info"
    },
    {
