      "label": "Enable",
      "default": false
    },
    {
      "type": "header",
      "content": "⚙️ Configuration"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Interval",
      "default": 5
    },
    {
      "type": "header",
      "content": "💻 Desktop Settings"
    },
    {
      "type": "range",
      "id": "desktop_slides",
      "min": 1,
      "max": 6,
      "step": 0.1,
      "label": "Slides per view",
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop_spacing",
      "min": 0,
      "max": 100,
      "label": "Spacing (px)",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "desktop_arrows",
      "label": "Show Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "desktop_dots",
      "label": "Show Dots",
      "default": false
    },
    {
      "type": "header",
      "content": "📱 Mobile Settings"
    },
    {
      "type": "range",
      "id": "mobile_slides",
      "min": 1,
      "max": 6,
      "step": 0.1,
      "label": "Slides per view",
      "default": 1.2
    },
    {
      "type": "range",
      "id": "mobile_spacing",
      "min": 0,
      "max": 50,
      "label": "Spacing (px)",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "mobile_arrows",
      "label": "Show Arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mobile_dots",
      "label": "Show Dots",
      "default": true
    }
  ],
  "blocks": [
    {
